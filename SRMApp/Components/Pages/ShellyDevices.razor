@page "/shelly-devices"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient
@inject ICrudPageDataService CrudPageDataService
@inject AuthSessionService AuthSessionService

<PageTitle>@LanguageService.T("ShellyDevices")</PageTitle>

<PageHeader Title="@LanguageService.T("ShellyDevices")" Description="@LanguageService.T("ShellyDevicesOverviewDescription")">
    <Actions>
        @if (agentId is not null)
        {
            <a class="btn btn-outline-primary" href="/agents">@LanguageService.T("BackToAgents")</a>
        }
        else if (serverRoomId is not null)
        {
            <a class="btn btn-outline-primary" href="/serverrooms/@serverRoomId/details">@LanguageService.T("BackToServerRooms")</a>
        }
        else if (customerId is not null && AuthSessionService.CanManageCustomers)
        {
            <a class="btn btn-outline-primary" href="/customers/@customerId/details">@LanguageService.T("BackToCustomerOverview")</a>
        }
        @if (AuthSessionService.CanManageConfiguration)
        {
            <a class="btn btn-primary" href="@GetCreateHref()">@LanguageService.T("CreateShellyDevice")</a>
        }
    </Actions>
</PageHeader>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else if (items.Count == 0)
{
    <div class="empty-state">
        <h3>@LanguageService.T("NoData")</h3>
        <p class="subtle">@LanguageService.T("ShellyDevicesOverviewDescription")</p>
    </div>
}
else
{
    <div class="stats-grid">
        @foreach (var item in items)
        {
            <SummaryStatCard CardClass="@(item.IsActive ? "alert-ok" : "alert-warning")"
                             IconClass="stat-icon-sensors"
                             Title="@item.Name"
                             Value="@(!item.IsActive ? LanguageService.T("Inactive") : item.IsVirtual ? LanguageService.T("Virtual") : LanguageService.T("Active"))"
                             SummaryText="@GetShellySummaryText(item)"
                             SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(item.IsActive ? "alert-ok" : "alert-warning")"
                             SecondaryText="@item.BaseUrl">
                <Details>
                    <div>@item.DeviceType</div>
                    <div>@item.MacAddress</div>
                </Details>
                <Actions>
                    @if (AuthSessionService.CanManageConfiguration)
                    {
                        <a class="btn btn-outline-primary btn-sm" href="@GetEditHref(item.Id)">@LanguageService.T("Edit")</a>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(item.Id)">@LanguageService.T("Delete")</button>
                    }
                    <a class="btn btn-primary btn-sm" href="/sensor-readings?shellyDeviceId=@item.Id">@LanguageService.T("SensorReadings")</a>
                    <a class="btn btn-outline-primary btn-sm" href="/incidents?shellyDeviceId=@item.Id">@LanguageService.T("Incidents")</a>
                </Actions>
            </SummaryStatCard>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public Guid? agentId { get; set; }
    [SupplyParameterFromQuery] public Guid? serverRoomId { get; set; }
    [SupplyParameterFromQuery] public Guid? customerId { get; set; }

    private bool isLoading = true;
    private List<ShellyDeviceReadDto> items = [];

    protected override async Task OnParametersSetAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        var pageData = await CrudPageDataService.GetShellyDevicePageDataAsync(agentId, serverRoomId, customerId);
        items = pageData.Items.ToList();
        isLoading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteShellyDeviceAsync(id);
        await LoadAsync();
    }

    private string GetCreateHref()
        => agentId is not null
            ? $"/shelly-devices/create?agentId={agentId}"
            : serverRoomId is not null
                ? $"/shelly-devices/create?serverRoomId={serverRoomId}"
                : customerId is not null
                    ? $"/shelly-devices/create?customerId={customerId}"
                    : "/shelly-devices/create";

    private string GetEditHref(Guid id)
        => agentId is not null
            ? $"/shelly-devices/{id}/edit?agentId={agentId}"
            : serverRoomId is not null
                ? $"/shelly-devices/{id}/edit?serverRoomId={serverRoomId}"
                : customerId is not null
                    ? $"/shelly-devices/{id}/edit?customerId={customerId}"
                    : $"/shelly-devices/{id}/edit";

    private string GetShellySummaryText(ShellyDeviceReadDto item)
        => !item.IsActive ? LanguageService.T("Inactive")
            : item.IsVirtual ? LanguageService.T("VirtualShellyConfigured")
            : LanguageService.T("ShellyConfigured");
}
