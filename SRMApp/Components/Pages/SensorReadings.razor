@page "/sensor-readings"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICrudPageDataService CrudPageDataService

<PageTitle>@LanguageService.T("SensorReadings")</PageTitle>

<PageHeader Title="@LanguageService.T("SensorReadings")" Description="@LanguageService.T("AgentChildren")" />

<section class="entity-list">
    @if (isLoading)
    {
        <p>@LanguageService.T("Loading")</p>
    }
    else if (items.Count == 0)
    {
        <p>@LanguageService.T("NoData")</p>
    }
    else
    {
        @foreach (var item in items.OrderByDescending(x => x.RecordedAtUtc))
        {
            <article class="entity-card">
                <div class="entity-card-header">
                    <div>
                        <h3>@OverviewUiHelper.FormatTemperatureCelsius(item.TemperatureCelsius)</h3>
                        <div class="subtle">@LanguageService.T("RecordedAt"): @OverviewUiHelper.FormatLocalDateTime(item.RecordedAtUtc)</div>
                        <div class="subtle">@LanguageService.T("Battery"): @OverviewUiHelper.FormatPercentage(item.BatteryPercent) | @LanguageService.T("Brightness"): @item.Brightness | @LanguageService.T("Door"): @(item.DoorOpen ? LanguageService.T("Open") : LanguageService.T("Closed"))</div>
                    </div>
                </div>
            </article>
        }
    }
</section>

@code {
    [SupplyParameterFromQuery] public Guid? shellyDeviceId { get; set; }

    private bool isLoading = true;
    private List<SensorReadingReadDto> items = [];

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        items = (await CrudPageDataService.GetSensorReadingPageDataAsync(shellyDeviceId)).Items.ToList();
        isLoading = false;
    }
}
