@page "/sensor-readings"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient
@inject ICrudPageDataService CrudPageDataService

<PageTitle>@LanguageService.T("SensorReadings")</PageTitle>

<PageHeader Title="@LanguageService.T("SensorReadings")" Description="@LanguageService.T("AgentChildren")" />

<div class="entity-grid">
    <section class="entity-list">
        @if (isLoading)
        {
            <p>@LanguageService.T("Loading")</p>
        }
        else if (items.Count == 0)
        {
            <p>@LanguageService.T("NoData")</p>
        }
        else
        {
            @foreach (var item in items)
            {
                <article class="entity-card">
                    <div class="entity-card-header">
                        <div>
                            <h3>@OverviewUiHelper.FormatTemperatureCelsius(item.TemperatureCelsius)</h3>
                            <div class="subtle">@LanguageService.T("RecordedAt"): @OverviewUiHelper.FormatLocalDateTime(item.RecordedAtUtc)</div>
                            <div class="subtle">@LanguageService.T("Battery"): @OverviewUiHelper.FormatPercentage(item.BatteryPercent) | @LanguageService.T("Brightness"): @item.Brightness | @LanguageService.T("Door"): @(item.DoorOpen ? LanguageService.T("Open") : LanguageService.T("Closed"))</div>
                        </div>
                    </div>
                    <div class="child-links">
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => BeginEdit(item)">@LanguageService.T("Edit")</button>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(item.Id)">@LanguageService.T("Delete")</button>
                    </div>
                </article>
            }
        }
    </section>

    <section class="form-card">
        <h3>@(editingId is null ? $"{LanguageService.T("Create")} {LanguageService.T("SensorReadings")}" : $"{LanguageService.T("Update")} {LanguageService.T("SensorReadings")}")</h3>
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <div>
                    <label class="form-label">@LanguageService.T("ShellyDevice")</label>
                    <InputSelect class="form-select" @bind-Value="form.ShellyDeviceId" disabled="@(shellyDeviceId is not null)">
                        <option value="@Guid.Empty">@LanguageService.T("SelectShellyDevice")</option>
                        @foreach (var device in shellyDevicesForSelection)
                        {
                            <option value="@device.Id">@device.Name</option>
                        }
                    </InputSelect>
                </div>
                <div><label class="form-label">@LanguageService.T("Temperature")</label><InputNumber class="form-control" @bind-Value="form.TemperatureCelsius" /></div>
                <div><label class="form-label">@LanguageService.T("Battery") (%)</label><InputNumber class="form-control" @bind-Value="form.BatteryPercent" /></div>
                <div><label class="form-label">@LanguageService.T("Brightness")</label><InputNumber class="form-control" @bind-Value="form.Brightness" /></div>
                <div><label class="form-label">@LanguageService.T("RecordedAt")</label><InputDate class="form-control" @bind-Value="form.RecordedAtUtc" /></div>
                <div class="form-check mt-4"><InputCheckbox class="form-check-input" @bind-Value="form.DoorOpen" /><label class="form-check-label">@LanguageService.T("DoorOpenLabel")</label></div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@LanguageService.T("Save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">@LanguageService.T("Cancel")</button>
            </div>
        </EditForm>
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public Guid? shellyDeviceId { get; set; }

    private bool isLoading = true;
    private List<SensorReadingReadDto> items = [];
    private List<ShellyDeviceReadDto> shellyDevicesForSelection = [];
    private SensorReadingCreateDto form = new() { RecordedAtUtc = DateTime.UtcNow };
    private Guid? editingId;

    protected override async Task OnParametersSetAsync()
    {
        if (shellyDeviceId is not null)
        {
            form.ShellyDeviceId = shellyDeviceId.Value;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var pageData = await CrudPageDataService.GetSensorReadingPageDataAsync(shellyDeviceId);
        items = pageData.Items.ToList();
        shellyDevicesForSelection = pageData.ShellyDevicesForSelection.ToList();
        isLoading = false;
    }

    private void BeginEdit(SensorReadingReadDto item)
    {
        editingId = item.Id;
        form = new SensorReadingCreateDto
        {
            ShellyDeviceId = item.ShellyDeviceId,
            TemperatureCelsius = item.TemperatureCelsius,
            BatteryPercent = item.BatteryPercent,
            Brightness = item.Brightness,
            DoorOpen = item.DoorOpen,
            RecordedAtUtc = item.RecordedAtUtc
        };
    }

    private async Task SaveAsync()
    {
        if (editingId is null)
            await ApiClient.CreateSensorReadingAsync(form);
        else
            await ApiClient.UpdateSensorReadingAsync(editingId.Value, new SensorReadingUpdateDto
            {
                ShellyDeviceId = form.ShellyDeviceId,
                TemperatureCelsius = form.TemperatureCelsius,
                BatteryPercent = form.BatteryPercent,
                Brightness = form.Brightness,
                DoorOpen = form.DoorOpen,
                RecordedAtUtc = form.RecordedAtUtc
            });

        ResetForm();
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteSensorReadingAsync(id);
        if (editingId == id) ResetForm();
        await LoadAsync();
    }

    private void ResetForm()
    {
        editingId = null;
        form = new SensorReadingCreateDto { ShellyDeviceId = shellyDeviceId ?? Guid.Empty, RecordedAtUtc = DateTime.UtcNow };
    }
}
