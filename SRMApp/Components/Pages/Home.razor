@page "/"
@inherits LocalizedComponentBase
@inject AuthSessionService AuthSessionService

<PageTitle>@LanguageService.T("AppTitle")</PageTitle>

<section class="hero">
    <span class="badge-soft">SRM</span>
    <h1>@LanguageService.T("WelcomeHeadline")</h1>
    <p>@LanguageService.T("WelcomeText")</p>
    <div class="hero-actions">
        @if (AuthSessionService.IsAuthenticated)
        {
            <a class="btn btn-light" href="/dashboard">@LanguageService.T("Dashboard")</a>
            <a class="btn btn-outline-light" href="/customers">@LanguageService.T("Customers")</a>
            <a class="btn btn-outline-light" href="/help">@LanguageService.T("Help")</a>
        }
        else
        {
            <a class="btn btn-light" href="/login">@LanguageService.T("Login")</a>
        }
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        AuthSessionService.AuthenticationChanged += OnAuthenticationChanged;
    }

    private void OnAuthenticationChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        AuthSessionService.AuthenticationChanged -= OnAuthenticationChanged;
        base.Dispose();
    }
}
