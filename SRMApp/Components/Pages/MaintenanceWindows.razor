@page "/maintenance-windows"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient
@inject ICrudPageDataService CrudPageDataService

<PageTitle>@LanguageService.T("MaintenanceWindows")</PageTitle>

<PageHeader Title="@LanguageService.T("MaintenanceWindows")" Description="@LanguageService.T("MaintenanceWindowsOverviewDescription")">
    <Actions>
        <a class="btn btn-primary" href="@GetCreateHref()">@LanguageService.T("CreateMaintenanceWindow")</a>
        @if (serverRoomId is not null)
        {
            <a class="btn btn-outline-primary" href="/serverrooms/@serverRoomId/details">@LanguageService.T("BackToServerRooms")</a>
        }
        else if (customerId is not null)
        {
            <a class="btn btn-outline-primary" href="/customers/@customerId/details">@LanguageService.T("BackToCustomerOverview")</a>
        }
    </Actions>
</PageHeader>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else if (items.Count == 0)
{
    <div class="empty-state">
        <h3>@LanguageService.T("NoData")</h3>
        <p class="subtle">@LanguageService.T("MaintenanceWindowsOverviewDescription")</p>
        <a class="btn btn-primary" href="@GetCreateHref()">@LanguageService.T("CreateMaintenanceWindow")</a>
    </div>
}
else
{
    <div class="stats-grid">
        @foreach (var item in items)
        {
            var cardClass = GetMaintenanceCardClass(item);
            <SummaryStatCard CardClass="@cardClass"
                             IconClass="stat-icon-maintenance"
                             Title="@item.Title"
                             Value="@GetMaintenanceValue(item)"
                             SummaryText="@GetMaintenanceSummaryText(item)"
                             SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(cardClass)"
                             SecondaryText="@($"{OverviewUiHelper.FormatLocalDateTime(item.StartUtc)} - {OverviewUiHelper.FormatLocalDateTime(item.EndUtc)}")">
                <Details>
                    <div>@item.Description</div>
                </Details>
                <Actions>
                    <a class="btn btn-outline-primary btn-sm" href="@GetEditHref(item.Id)">@LanguageService.T("Edit")</a>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(item.Id)">@LanguageService.T("Delete")</button>
                </Actions>
            </SummaryStatCard>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public Guid? serverRoomId { get; set; }
    [SupplyParameterFromQuery] public Guid? customerId { get; set; }
    private bool isLoading = true;
    private List<MaintenanceWindowReadDto> items = [];

    protected override async Task OnParametersSetAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        var pageData = await CrudPageDataService.GetMaintenanceWindowPageDataAsync(serverRoomId, customerId);
        items = pageData.Items.ToList();
        isLoading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteMaintenanceWindowAsync(id);
        await LoadAsync();
    }

    private string GetCreateHref()
        => serverRoomId is not null ? $"/maintenance-windows/create?serverRoomId={serverRoomId}"
            : customerId is not null ? $"/maintenance-windows/create?customerId={customerId}"
            : "/maintenance-windows/create";

    private string GetEditHref(Guid id)
        => serverRoomId is not null ? $"/maintenance-windows/{id}/edit?serverRoomId={serverRoomId}"
            : customerId is not null ? $"/maintenance-windows/{id}/edit?customerId={customerId}"
            : $"/maintenance-windows/{id}/edit";

    private string GetMaintenanceCardClass(MaintenanceWindowReadDto item)
    {
        var now = DateTime.UtcNow;
        if (item.StartUtc <= now && item.EndUtc >= now) return "alert-warning";
        if (item.StartUtc > now) return "alert-ok";
        return string.Empty;
    }

    private string GetMaintenanceValue(MaintenanceWindowReadDto item)
    {
        var now = DateTime.UtcNow;
        if (item.StartUtc <= now && item.EndUtc >= now) return LanguageService.T("Active");
        if (item.StartUtc > now) return LanguageService.T("Upcoming");
        return LanguageService.T("Completed");
    }

    private string GetMaintenanceSummaryText(MaintenanceWindowReadDto item)
        => item.StartUtc > DateTime.UtcNow ? LanguageService.T("MaintenanceScheduled")
            : item.EndUtc >= DateTime.UtcNow ? LanguageService.T("MaintenanceInProgress")
            : LanguageService.T("MaintenanceFinished");
}
