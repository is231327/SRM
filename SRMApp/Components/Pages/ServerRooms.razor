@page "/serverrooms"
@page "/customers/{CustomerId:guid}/serverrooms"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient
@inject ICrudPageDataService CrudPageDataService

<PageTitle>@LanguageService.T("ServerRooms")</PageTitle>

<PageHeader Title="@LanguageService.T("ServerRooms")" Description="@LanguageService.T("ServerRoomsOverviewDescription")">
    <Actions>
        <a class="btn btn-primary" href="@GetCreateHref()">@LanguageService.T("CreateServerRoom")</a>
        @if (CustomerId is not null)
        {
            <a class="btn btn-outline-primary" href="/customers/@CustomerId/details">@LanguageService.T("BackToCustomerOverview")</a>
        }
    </Actions>
</PageHeader>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else if (serverRooms.Count == 0)
{
    <div class="empty-state">
        <h3>@LanguageService.T("NoData")</h3>
        <p class="subtle">@LanguageService.T("ServerRoomsOverviewDescription")</p>
        <a class="btn btn-primary" href="@GetCreateHref()">@LanguageService.T("CreateServerRoom")</a>
    </div>
}
else
{
    <div class="stats-grid">
        @foreach (var room in serverRooms)
        {
            var cardClass = GetServerRoomCardClass(room);
            <SummaryStatCard CardClass="@cardClass"
                             IconClass="stat-icon-rooms"
                             Title="@room.Name"
                             Value="@(room.MonitoringEnabled ? LanguageService.T("Active") : LanguageService.T("Inactive"))"
                             SummaryText="@GetServerRoomSummaryText(room)"
                             SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(cardClass)"
                             SecondaryText="@room.LocationDescription">
                <Details>
                    <div>@LanguageService.T("WarningThreshold"): @OverviewUiHelper.FormatTemperatureCelsius(room.TemperatureWarningThreshold)</div>
                    <div>@LanguageService.T("CriticalThreshold"): @OverviewUiHelper.FormatTemperatureCelsius(room.TemperatureCriticalThreshold)</div>
                </Details>
                <Actions>
                    <a class="btn btn-primary btn-sm" href="/serverrooms/@room.Id/details">@LanguageService.T("Overview")</a>
                    <a class="btn btn-outline-primary btn-sm" href="@GetEditHref(room.Id)">@LanguageService.T("Edit")</a>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(room.Id)">@LanguageService.T("Delete")</button>
                </Actions>
            </SummaryStatCard>
        }
    </div>
}

@code {
    [Parameter] public Guid? CustomerId { get; set; }

    private bool isLoading = true;
    private List<ServerRoomReadDto> serverRooms = [];

    protected override async Task OnParametersSetAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        var pageData = await CrudPageDataService.GetServerRoomPageDataAsync(CustomerId);
        serverRooms = pageData.ServerRooms.ToList();
        isLoading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteServerRoomAsync(id);
        await LoadAsync();
    }

    private string GetCreateHref()
        => CustomerId is not null ? $"/serverrooms/create?customerId={CustomerId}" : "/serverrooms/create";

    private string GetEditHref(Guid id)
        => CustomerId is not null ? $"/serverrooms/{id}/edit?customerId={CustomerId}" : $"/serverrooms/{id}/edit";

    private string GetServerRoomCardClass(ServerRoomReadDto room)
        => !room.MonitoringEnabled ? "alert-warning" : "alert-ok";

    private string GetServerRoomSummaryText(ServerRoomReadDto room)
        => !room.MonitoringEnabled ? LanguageService.T("MonitoringDisabled")
            : LanguageService.T("ServerRoomConfigured");
}
