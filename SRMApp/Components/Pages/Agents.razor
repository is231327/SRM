@page "/agents"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient
@inject ICrudPageDataService CrudPageDataService

<PageTitle>@LanguageService.T("Agents")</PageTitle>

<PageHeader Title="@LanguageService.T("Agents")" Description="@LanguageService.T("AgentsOverviewDescription")">
    <Actions>
        <a class="btn btn-primary" href="@GetCreateHref()">@LanguageService.T("CreateAgent")</a>
        @if (serverRoomId is not null)
        {
            <a class="btn btn-outline-primary" href="/serverrooms/@serverRoomId/details">@LanguageService.T("BackToServerRooms")</a>
        }
        else if (customerId is not null)
        {
            <a class="btn btn-outline-primary" href="/customers/@customerId/details">@LanguageService.T("BackToCustomerOverview")</a>
        }
    </Actions>
</PageHeader>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else if (agents.Count == 0)
{
    <div class="empty-state">
        <h3>@LanguageService.T("NoData")</h3>
        <p class="subtle">@LanguageService.T("AgentsOverviewDescription")</p>
        <a class="btn btn-primary" href="@GetCreateHref()">@LanguageService.T("CreateAgent")</a>
    </div>
}
else
{
    <div class="stats-grid">
        @foreach (var item in agents)
        {
            <SummaryStatCard CardClass="@GetAgentCardClass(item)"
                             IconClass="stat-icon-agents"
                             Title="@item.Name"
                             Value="@GetAgentValue(item)"
                             SummaryText="@GetAgentSummaryText(item)"
                             SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetAgentCardClass(item))"
                             SecondaryText="@GetAgentSecondaryText(item)">
                <Details>
                    <div>@item.Version</div>
                    <div>@item.LastKnownIpAddress</div>
                </Details>
                <Actions>
                    <a class="btn btn-outline-primary btn-sm" href="@GetEditHref(item.Id)">@LanguageService.T("Edit")</a>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(item.Id)">@LanguageService.T("Delete")</button>
                    <a class="btn btn-primary btn-sm" href="/shelly-devices?agentId=@item.Id">@LanguageService.T("ShellyDevices")</a>
                    <a class="btn btn-outline-primary btn-sm" href="/monitored-devices?agentId=@item.Id">@LanguageService.T("MonitoredDevices")</a>
                </Actions>
            </SummaryStatCard>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public Guid? serverRoomId { get; set; }
    [SupplyParameterFromQuery] public Guid? customerId { get; set; }

    private bool isLoading = true;
    private List<AgentReadDto> agents = [];

    protected override async Task OnParametersSetAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        var pageData = await CrudPageDataService.GetAgentPageDataAsync(serverRoomId, customerId);
        agents = pageData.Agents.ToList();
        isLoading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteAgentAsync(id);
        await LoadAsync();
    }

    private string GetCreateHref()
        => serverRoomId is not null
            ? $"/agents/create?serverRoomId={serverRoomId}"
            : customerId is not null
                ? $"/agents/create?customerId={customerId}"
                : "/agents/create";

    private string GetEditHref(Guid id)
        => serverRoomId is not null
            ? $"/agents/{id}/edit?serverRoomId={serverRoomId}"
            : customerId is not null
                ? $"/agents/{id}/edit?customerId={customerId}"
                : $"/agents/{id}/edit";

    private string GetAgentCardClass(AgentReadDto item)
        => !item.IsActive ? "alert-warning" : !item.LastSeenAtUtc.HasValue ? "alert-info" : "alert-ok";

    private string GetAgentValue(AgentReadDto item)
        => item.IsActive ? LanguageService.T("Active") : LanguageService.T("Inactive");

    private string GetAgentSummaryText(AgentReadDto item)
        => !item.IsActive
            ? LanguageService.T("InactiveAgentsPresent")
            : !item.LastSeenAtUtc.HasValue
                ? LanguageService.T("AgentsNotReportedYet")
                : LanguageService.T("AllAgentsActive");

    private string GetAgentSecondaryText(AgentReadDto item)
        => OverviewUiHelper.FormatLastLogLabel(item.LastSeenAtUtc, LanguageService.T);
}
