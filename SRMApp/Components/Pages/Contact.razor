@page "/contact"
@inherits LocalizedComponentBase

<PageTitle>@LanguageService.T("Contact")</PageTitle>

<div class="page-header">
    <div>
        <h1>@LanguageService.T("Contact")</h1>
        <p>@LanguageService.T("ContactText")</p>
    </div>
</div>

<div class="panel-grid">
    <div class="panel-card">
        <h3>Project Coordination</h3>
        <div class="info-list">
            <div class="info-item"><strong>Email</strong><span>srm-support@example.local</span></div>
            <div class="info-item"><strong>Issue Tracker</strong><span>Use the internal project tracker for incidents and change requests.</span></div>
        </div>
    </div>
    <div class="panel-card">
        <h3>Operational Notes</h3>
        <p class="subtle">Coordinate backend changes, Docker lifecycle actions, and integration test execution through the development team.</p>
    </div>
</div>
