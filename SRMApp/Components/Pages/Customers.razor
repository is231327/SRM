@page "/customers"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient

<PageTitle>@LanguageService.T("Customers")</PageTitle>

<div class="page-header">
    <div>
        <h1>@LanguageService.T("Customers")</h1>
        <p>@LanguageService.T("CustomersPageDescription")</p>
    </div>
</div>

<div class="entity-grid">
    <section class="entity-list">
        @if (isLoading)
        {
            <p>@LanguageService.T("Loading")</p>
        }
        else if (customers.Count == 0)
        {
            <p>@LanguageService.T("NoData")</p>
        }
        else
        {
            @foreach (var customer in customers)
            {
                <article class="entity-card">
                    <div class="entity-card-header">
                        <div>
                            <h3>@customer.Name</h3>
                            <div class="subtle">@customer.ContactEmail</div>
                            <div class="subtle">@customer.ContactPhone</div>
                        </div>
                        <span class="badge-soft">@(customer.IsActive ? LanguageService.T("Active") : "Inactive")</span>
                    </div>
                    <div class="child-links">
                        <a class="btn btn-primary btn-sm" href="/customers/@customer.Id/details">@LanguageService.T("Overview")</a>
                        <a class="btn btn-outline-primary btn-sm" href="/customers/@customer.Id/edit">@LanguageService.T("Edit")</a>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(customer.Id)">@LanguageService.T("Delete")</button>
                    </div>
                </article>
            }
        }
    </section>

    <section class="form-card">
        <h3>@($"{LanguageService.T("Create")} {LanguageService.T("Customers")}")</h3>
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <div><label class="form-label">@LanguageService.T("Name")</label><InputText class="form-control" @bind-Value="form.Name" /></div>
                <div><label class="form-label">@LanguageService.T("ExternalReference")</label><InputText class="form-control" @bind-Value="form.ExternalReference" /></div>
                <div><label class="form-label">@LanguageService.T("Email")</label><InputText class="form-control" @bind-Value="form.ContactEmail" /></div>
                <div><label class="form-label">@LanguageService.T("Phone")</label><InputText class="form-control" @bind-Value="form.ContactPhone" /></div>
                <div class="form-check mt-4"><InputCheckbox class="form-check-input" @bind-Value="form.IsActive" /><label class="form-check-label">@LanguageService.T("Active")</label></div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@LanguageService.T("Save")</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">@LanguageService.T("Cancel")</button>
            </div>
        </EditForm>
    </section>
</div>

@code {
    private bool isLoading = true;
    private List<CustomerReadDto> customers = [];
    private CustomerCreateDto form = new() { IsActive = true };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        customers = await ApiClient.GetCustomersAsync();
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        await ApiClient.CreateCustomerAsync(form);
        ResetForm();
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteCustomerAsync(id);
        await LoadAsync();
    }

    private void ResetForm()
    {
        form = new CustomerCreateDto { IsActive = true };
    }
}
