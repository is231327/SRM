@page "/customers"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject IOverviewDataService OverviewDataService
@inject ICoreApiClient ApiClient

<PageTitle>@LanguageService.T("Customers")</PageTitle>

<PageHeader Title="@LanguageService.T("Customers")" Description="@LanguageService.T("CustomersOverviewDescription")">
    <Actions>
        <a class="btn btn-primary" href="/customers/create">@LanguageService.T("CreateCustomer")</a>
    </Actions>
</PageHeader>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else if (!customers.Any())
{
    <div class="empty-state">
        <h3>@LanguageService.T("NoData")</h3>
        <p class="subtle">@LanguageService.T("CustomersOverviewDescription")</p>
        <a class="btn btn-primary" href="/customers/create">@LanguageService.T("CreateCustomer")</a>
    </div>
}
else
{
    <div class="stats-grid">
        @foreach (var customer in customers)
        {
            <SummaryStatCard CardClass="@GetCustomerCardClass(customer.Id)"
                             IconClass="stat-icon-customers"
                             Title="@customer.Name"
                             Value="@GetIncidentCount(customer.Id).ToString()"
                             SummaryText="@GetCustomerSummaryText(customer)"
                             SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetCustomerCardClass(customer.Id))"
                             SecondaryText="@GetCustomerSecondaryText(customer)"
                             ViewAllHref="@($"/customers/{customer.Id}/details")"
                             ViewAllText="@LanguageService.T("Overview")">
                <Details>
                    <div>@LanguageService.Tf("CustomerContactInfo", GetContactLine(customer))</div>
                </Details>
                <Actions>
                    <a class="btn btn-outline-primary btn-sm" href="/customers/@customer.Id/details">@LanguageService.T("Overview")</a>
                    <a class="btn btn-outline-primary btn-sm" href="/customers/@customer.Id/edit">@LanguageService.T("Edit")</a>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(customer.Id)">@LanguageService.T("Delete")</button>
                </Actions>
            </SummaryStatCard>
        }
    </div>
}

@code {
    private bool isLoading = true;
    private DashboardOverviewData? overview;
    private IReadOnlyList<CustomerReadDto> customers => overview?.Customers ?? [];
    private IReadOnlyList<ServerRoomReadDto> serverRooms => overview?.ServerRooms ?? [];
    private IReadOnlyList<AgentReadDto> agents => overview?.Agents ?? [];
    private IReadOnlyList<IncidentReadDto> incidents => overview?.Incidents ?? [];
    private IReadOnlyDictionary<Guid, int> incidentCountByCustomerId => overview?.IncidentCountByCustomerId ?? new Dictionary<Guid, int>();
    private IReadOnlyDictionary<Guid, DateTime?> lastActivityByCustomerId => overview?.LastActivityByCustomerId ?? new Dictionary<Guid, DateTime?>();
    private IReadOnlyDictionary<Guid, string> cardClassByCustomerId => overview?.CardClassByCustomerId ?? new Dictionary<Guid, string>();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        overview = await OverviewDataService.GetDashboardOverviewAsync();
        isLoading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteCustomerAsync(id);
        await LoadAsync();
    }

    private string GetCustomerCardClass(Guid customerId)
        => cardClassByCustomerId.GetValueOrDefault(customerId, "alert-ok");

    private int GetIncidentCount(Guid customerId)
        => incidentCountByCustomerId.GetValueOrDefault(customerId);

    private string GetCustomerSummaryText(CustomerReadDto customer)
    {
        var openCount = incidentCountByCustomerId.GetValueOrDefault(customer.Id);
        var cardClass = GetCustomerCardClass(customer.Id);

        return cardClass switch
        {
            "alert-critical" => LanguageService.T("CriticalIncidentsImmediateReview"),
            "alert-warning" => openCount > 0
                ? LanguageService.Tf("CustomerOpenIncidentsCount", openCount)
                : LanguageService.T("OpenIncidentsTracked"),
            _ => customer.IsActive
                ? LanguageService.T("CustomerPortfolioStable")
                : LanguageService.T("Inactive")
        };
    }

    private string GetCustomerSecondaryText(CustomerReadDto customer)
        => lastActivityByCustomerId.TryGetValue(customer.Id, out var value) && value.HasValue
            ? LanguageService.Tf("LastActivityAt", OverviewUiHelper.FormatLocalDateTime(value.Value))
            : LanguageService.T("NoActivityRecordedYet");

    private string GetContactLine(CustomerReadDto customer)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(customer.ContactEmail))
        {
            parts.Add(customer.ContactEmail);
        }

        if (!string.IsNullOrWhiteSpace(customer.ContactPhone))
        {
            parts.Add(customer.ContactPhone);
        }

        return parts.Count > 0
            ? string.Join(" | ", parts)
            : LanguageService.T("NoContactInformation");
    }

}
