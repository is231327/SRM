@page "/dashboard"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient

<PageTitle>@LanguageService.T("Dashboard")</PageTitle>

<div class="page-header">
    <div>
        <h1>@LanguageService.T("Dashboard")</h1>
        <p>@LanguageService.T("HierarchyHint")</p>
    </div>
</div>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else
{
    <div class="stats-grid">
        <div class="stat-card"><h3>@LanguageService.T("CustomersCard")</h3><div class="stat-value">@customers.Count</div></div>
        <div class="stat-card"><h3>@LanguageService.T("RoomsCard")</h3><div class="stat-value">@serverRooms.Count</div></div>
        <div class="stat-card"><h3>@LanguageService.T("AgentsCard")</h3><div class="stat-value">@agents.Count</div></div>
        <div class="stat-card"><h3>@LanguageService.T("SensorsCard")</h3><div class="stat-value">@sensorReadings.Count</div></div>
        <div class="stat-card"><h3>@LanguageService.T("OpenIncidents")</h3><div class="stat-value">@openIncidents.Count</div></div>
        <div class="stat-card"><h3>@LanguageService.T("CriticalIncidents")</h3><div class="stat-value">@criticalIncidents.Count</div></div>
    </div>

    <div class="panel-grid">
        <div class="panel-card">
            <h3>@LanguageService.T("QuickActions")</h3>
            <div class="child-links">
                <a class="btn btn-primary" href="/customers">@LanguageService.T("Customers")</a>
                <a class="btn btn-outline-primary" href="/incidents">@LanguageService.T("Incidents")</a>
                <a class="btn btn-outline-primary" href="/users">@LanguageService.T("Users")</a>
            </div>
        </div>
        <div class="panel-card">
            <h3>@LanguageService.T("SystemStatus")</h3>
            <div class="info-list">
                <div class="info-item"><strong>@LanguageService.T("MonitoredDevices")</strong><span>@monitoredDevices.Count</span></div>
                <div class="info-item"><strong>@LanguageService.T("ShellyDevices")</strong><span>@shellyDevices.Count</span></div>
                <div class="info-item"><strong>@LanguageService.T("MaintenanceWindows")</strong><span>@maintenanceWindows.Count</span></div>
            </div>
        </div>
    </div>

    <div class="panel-grid">
        <section class="panel-card">
            <div class="section-heading">
                <div>
                    <h3>@LanguageService.T("RecentIncidents")</h3>
                    <p class="subtle">@LanguageService.T("DashboardIncidentsDescription")</p>
                </div>
                <a class="btn btn-outline-primary btn-sm" href="/incidents">@LanguageService.T("ViewAll")</a>
            </div>
            @foreach (var incident in recentIncidents)
            {
                <article class="entity-card compact-card">
                    <div class="entity-card-header">
                        <div>
                            <h3>@incident.Summary</h3>
                            <div class="subtle">@incident.ServerRoomName</div>
                            <div class="subtle">@LanguageService.T("Severity"): @LanguageService.T(incident.Severity.ToString()) | @LanguageService.T("Status"): @LanguageService.T(incident.Status.ToString())</div>
                        </div>
                        <span class="badge-soft">@LanguageService.T(incident.Type.ToString())</span>
                    </div>
                    <div class="child-links">
                        <a class="btn btn-primary btn-sm" href="/incidents/@incident.Id">@LanguageService.T("Details")</a>
                    </div>
                </article>
            }
        </section>

        <section class="panel-card">
            <div class="section-heading">
                <div>
                    <h3>@LanguageService.T("CustomerActivity")</h3>
                    <p class="subtle">@LanguageService.T("DashboardCustomersDescription")</p>
                </div>
            </div>
            @foreach (var customer in topCustomers)
            {
                <article class="entity-card compact-card">
                    <div class="entity-card-header">
                        <div>
                            <h3>@customer.Name</h3>
                            <div class="subtle">@LanguageService.T("ServerRooms"): @serverRooms.Count(x => x.CustomerId == customer.Id)</div>
                            <div class="subtle">@LanguageService.T("Incidents"): @GetCustomerIncidentCount(customer.Id)</div>
                            <div class="subtle">@LanguageService.T("LastLog"): @FormatCustomerLastActivity(customer.Id)</div>
                        </div>
                    </div>
                    <div class="child-links">
                        <a class="btn btn-primary btn-sm" href="/customers/@customer.Id/details">@LanguageService.T("Overview")</a>
                    </div>
                </article>
            }
        </section>
    </div>
}

@code {
    private bool isLoading = true;
    private List<CustomerReadDto> customers = [];
    private List<ServerRoomReadDto> serverRooms = [];
    private List<AgentReadDto> agents = [];
    private List<ShellyDeviceReadDto> shellyDevices = [];
    private List<MonitoredDeviceReadDto> monitoredDevices = [];
    private List<MaintenanceWindowReadDto> maintenanceWindows = [];
    private List<SensorReadingReadDto> sensorReadings = [];
    private List<IncidentReadDto> incidents = [];
    private List<IncidentReadDto> openIncidents = [];
    private List<IncidentReadDto> criticalIncidents = [];
    private IEnumerable<IncidentReadDto> recentIncidents => incidents.OrderByDescending(x => x.OpenedAtUtc).Take(5);
    private IEnumerable<CustomerReadDto> topCustomers => customers.OrderByDescending(x => GetCustomerIncidentCount(x.Id)).Take(5);

    protected override async Task OnInitializedAsync()
    {
        customers = await ApiClient.GetCustomersAsync();
        serverRooms = await ApiClient.GetServerRoomsAsync();
        agents = await ApiClient.GetAgentsAsync();
        shellyDevices = await ApiClient.GetShellyDevicesAsync();
        monitoredDevices = await ApiClient.GetMonitoredDevicesAsync();
        maintenanceWindows = await ApiClient.GetMaintenanceWindowsAsync();
        sensorReadings = await ApiClient.GetSensorReadingsAsync();
        incidents = await ApiClient.GetIncidentsAsync();
        openIncidents = incidents.Where(x => x.Status.ToString() == "Open").ToList();
        criticalIncidents = incidents.Where(x => x.Severity.ToString() == "Critical").ToList();
        isLoading = false;
    }

    private string FormatCustomerLastActivity(Guid customerId)
    {
        var roomIds = serverRooms.Where(x => x.CustomerId == customerId).Select(x => x.Id).ToHashSet();
        var value = incidents
            .Where(x => roomIds.Contains(x.ServerRoomId))
            .Select(x => x.LastOccurredAtUtc ?? x.OpenedAtUtc)
            .OrderByDescending(x => x)
            .FirstOrDefault();

        return value == default ? LanguageService.T("NoData") : value.ToLocalTime().ToString("g");
    }

    private int GetCustomerIncidentCount(Guid customerId)
    {
        var roomIds = serverRooms.Where(x => x.CustomerId == customerId).Select(x => x.Id).ToHashSet();
        return incidents.Count(x => roomIds.Contains(x.ServerRoomId));
    }
}
