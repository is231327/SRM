@page "/dashboard"
@rendermode InteractiveServer
@using SRMShared.DTOs.MonitoredDevicePingResult
@inherits LocalizedComponentBase
@inject IOverviewDataService OverviewDataService
@inject AuthSessionService AuthSessionService

<PageTitle>@LanguageService.T("Dashboard")</PageTitle>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else
{
    <section class="hero hero-dashboard">
        <div class="hero-copy">
            <span class="eyebrow">@LanguageService.T("Dashboard")</span>
            <h1>@LanguageService.T("Dashboard")</h1>
            <p>@BuildDashboardLead()</p>
        </div>
    </section>

    <div class="stats-grid">
        @if (AuthSessionService.CanManageCustomers)
        {
            <SummaryStatCard CardClass="@GetCustomerSummaryClass()" IconClass="stat-icon-customers" Title="@LanguageService.T("CustomersCard")" Value="@customers.Count.ToString()" SummaryText="@GetCustomerSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetCustomerSummaryClass())" ViewAllHref="/customers" ViewAllText="@LanguageService.T("ViewAll")" />
        }
        <SummaryStatCard CardClass="@GetRoomsSummaryClass()" IconClass="stat-icon-rooms" Title="@LanguageService.T("RoomsCard")" Value="@serverRooms.Count.ToString()" SummaryText="@GetRoomSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetRoomsSummaryClass())" ViewAllHref="/serverrooms" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard CardClass="@GetAgentSummaryClass()" IconClass="stat-icon-agents" Title="@LanguageService.T("AgentsCard")" Value="@agents.Count.ToString()" SummaryText="@GetAgentSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetAgentSummaryClass())" ViewAllHref="/agents" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard CardClass="@GetShellySummaryClass()" IconClass="stat-icon-sensors" Title="@LanguageService.T("ShellyDevices")" Value="@shellyDevices.Count.ToString()" SummaryText="@GetShellySummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetShellySummaryClass())" ViewAllHref="/shelly-devices" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard CardClass="@GetMonitoredDevicesSummaryClass()" IconClass="stat-icon-rooms" Title="@LanguageService.T("MonitoredDevices")" Value="@monitoredDevices.Count.ToString()" SummaryText="@GetMonitoredDevicesSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetMonitoredDevicesSummaryClass())" ViewAllHref="/monitored-devices" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard IconClass="stat-icon-maintenance" Title="@LanguageService.T("MaintenanceWindows")" Value="@maintenanceWindows.Count.ToString()" SummaryText="@GetMaintenanceSummaryText()" ViewAllHref="/maintenance-windows" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard CardClass="@GetIncidentSummaryClass()" IconClass="stat-icon-alert" Title="@LanguageService.T("Incidents")" Value="@incidents.Count.ToString()" SummaryText="@GetIncidentSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetIncidentSummaryClass())" ViewAllHref="/incidents" ViewAllText="@LanguageService.T("ViewAll")" />
    </div>
}

@code {
    private bool isLoading = true;
    private DashboardOverviewData? overview;
    private IReadOnlyList<CustomerReadDto> customers => overview?.Customers ?? [];
    private IReadOnlyList<ServerRoomReadDto> serverRooms => overview?.ServerRooms ?? [];
    private IReadOnlyList<AgentReadDto> agents => overview?.Agents ?? [];
    private IReadOnlyList<ShellyDeviceReadDto> shellyDevices => overview?.ShellyDevices ?? [];
    private IReadOnlyList<MonitoredDeviceReadDto> monitoredDevices => overview?.MonitoredDevices ?? [];
    private IReadOnlyList<MaintenanceWindowReadDto> maintenanceWindows => overview?.MaintenanceWindows ?? [];
    private IReadOnlyList<SensorReadingReadDto> sensorReadings => overview?.SensorReadings ?? [];
    private IReadOnlyList<MonitoredDevicePingResultReadDto> pingResults => overview?.PingResults ?? [];
    private IReadOnlyList<IncidentReadDto> incidents => overview?.Incidents ?? [];
    private IReadOnlyList<IncidentReadDto> openIncidents => overview?.OpenIncidents ?? [];
    private IReadOnlyList<IncidentReadDto> openCriticalIncidents => overview?.OpenCriticalIncidents ?? [];
    private IReadOnlyDictionary<Guid, string> cardClassByCustomerId => overview?.CardClassByCustomerId ?? new Dictionary<Guid, string>();
    protected override async Task OnInitializedAsync()
    {
        overview = await OverviewDataService.GetDashboardOverviewAsync();
        isLoading = false;
    }

    private string GetCustomerCardClass(Guid customerId)
        => cardClassByCustomerId.GetValueOrDefault(customerId, "alert-ok");

    private string GetRoomsSummaryClass()
    {
        if (serverRooms.Count == 0)
        {
            return string.Empty;
        }

        if (customers.Any(x => GetCustomerCardClass(x.Id) == "alert-critical"))
        {
            return "alert-critical";
        }

        if (customers.Any(x => GetCustomerCardClass(x.Id) == "alert-warning"))
        {
            return "alert-warning";
        }

        if (serverRooms.Any(x => !x.MonitoringEnabled))
        {
            return "alert-warning";
        }

        return "alert-ok";
    }

    private string BuildDashboardLead()
    {
        if (openCriticalIncidents.Count > 0)
        {
            return LanguageService.Tf("DashboardLeadCritical", openCriticalIncidents.Count, openIncidents.Count);
        }

        if (openIncidents.Count > 0)
        {
            return AuthSessionService.IsCustomerScopedUser
                ? LanguageService.Tf("DashboardLeadOpenScoped", openIncidents.Count)
                : LanguageService.Tf("DashboardLeadOpen", openIncidents.Count, customers.Count);
        }

        return AuthSessionService.IsCustomerScopedUser
            ? LanguageService.Tf("DashboardLeadStableScoped", serverRooms.Count, agents.Count)
            : LanguageService.Tf("DashboardLeadStable", customers.Count, serverRooms.Count, agents.Count);
    }

    private string GetCustomerSummaryClass()
        => customers.Count == 0 ? string.Empty : customers.Any(x => !x.IsActive) ? "alert-warning" : "alert-ok";

    private string GetCustomerSummaryText()
        => customers.Count == 0
            ? LanguageService.T("NoData")
            : customers.Any(x => !x.IsActive)
                ? LanguageService.Tf("InactiveCustomersCount", customers.Count(x => !x.IsActive))
                : LanguageService.Tf("ConfiguredCustomerRecords", customers.Count);

    private string GetAgentSummaryClass()
        => agents.Count == 0
            ? string.Empty
            : agents.Any(x => !x.IsActive)
                ? "alert-warning"
                : agents.Any(x => !x.LastSeenAtUtc.HasValue)
                    ? "alert-info"
                    : "alert-ok";

    private string GetRoomSummaryText()
        => customers.Any(x => GetCustomerCardClass(x.Id) == "alert-critical")
            ? LanguageService.T("RoomSummaryCritical")
            : customers.Any(x => GetCustomerCardClass(x.Id) == "alert-warning")
                ? LanguageService.T("RoomSummaryOpen")
                : serverRooms.Any(x => !x.MonitoringEnabled)
                    ? LanguageService.T("SomeRoomMonitoringDisabled")
                : serverRooms.Count == 0
                    ? LanguageService.T("NoData")
                    : LanguageService.T("RoomSummaryStable");

    private string GetAgentSummaryText()
        => agents.Any(x => !x.IsActive)
            ? LanguageService.Tf("InactiveAgentsCount", agents.Count(x => !x.IsActive))
            : agents.Count == 0
                ? LanguageService.T("NoData")
                : agents.Any(x => !x.LastSeenAtUtc.HasValue)
                    ? LanguageService.T("AgentsNotReportedYet")
                    : LanguageService.T("AllAgentsHaveReported");

    private string GetShellySummaryClass()
    {
        if (shellyDevices.Count == 0)
        {
            return string.Empty;
        }

        if (openCriticalIncidents.Any(x => x.ShellyDeviceId.HasValue))
        {
            return "alert-critical";
        }

        if (openIncidents.Any(x => x.Type.ToString() == "DoorOpenOutsideMaintenanceWindow" || x.Type.ToString().Contains("Temperature")))
        {
            return "alert-warning";
        }

        if (shellyDevices.Any(x => !x.IsActive))
        {
            return "alert-warning";
        }

        return "alert-ok";
    }

    private string GetShellySummaryText()
        => openCriticalIncidents.Any(x => x.ShellyDeviceId.HasValue)
            ? LanguageService.T("ShellyCriticalIncidentOpen")
            : openIncidents.Any(x => x.Type.ToString() == "DoorOpenOutsideMaintenanceWindow")
                ? LanguageService.T("ShellyDoorOpen")
                : shellyDevices.Any(x => !x.IsActive)
                    ? LanguageService.Tf("InactiveShellyDevicesCount", shellyDevices.Count(x => !x.IsActive))
                : shellyDevices.Count == 0
                    ? LanguageService.T("NoData")
                    : shellyDevices.Any(device => sensorReadings.All(reading => reading.ShellyDeviceId != device.Id))
                        ? LanguageService.T("ShellyNoReadingsYet")
                        : LanguageService.T("ShellyReportingNormally");

    private string GetMonitoredDevicesSummaryClass()
    {
        if (monitoredDevices.Count == 0)
        {
            return string.Empty;
        }

        if (openIncidents.Any(x => x.MonitoredDeviceId.HasValue && x.Type.ToString() == "MonitoredDeviceFailureThresholdReached"))
        {
            return "alert-critical";
        }

        if (monitoredDevices.Any(x => !x.IsActive))
        {
            return "alert-warning";
        }

        if (pingResults
            .GroupBy(x => x.MonitoredDeviceId)
            .Select(x => x.OrderByDescending(y => y.RecordedAtUtc).First())
            .Any(x => !x.IsReachable))
        {
            return "alert-warning";
        }

        return "alert-ok";
    }

    private string GetMonitoredDevicesSummaryText()
        => openIncidents.Any(x => x.MonitoredDeviceId.HasValue && x.Type.ToString() == "MonitoredDeviceFailureThresholdReached")
            ? LanguageService.T("MonitoredDeviceThresholdDown")
            : pingResults
                .GroupBy(x => x.MonitoredDeviceId)
                .Select(x => x.OrderByDescending(y => y.RecordedAtUtc).First())
                .Any(x => !x.IsReachable)
                ? LanguageService.T("MonitoredDeviceUnreachable")
                : monitoredDevices.Any(x => !x.IsActive)
                    ? LanguageService.Tf("InactiveMonitoredDevicesCount", monitoredDevices.Count(x => !x.IsActive))
                : monitoredDevices.Count == 0
                    ? LanguageService.T("NoData")
                    : monitoredDevices.Any(device => pingResults.All(result => result.MonitoredDeviceId != device.Id))
                        ? LanguageService.T("MonitoredDeviceNoHistory")
                        : LanguageService.T("MonitoredDevicesReachable");

    private string GetMaintenanceSummaryText()
        => maintenanceWindows.Count == 0 ? LanguageService.T("NoData") : LanguageService.T("MaintenanceConfigured");

    private string GetIncidentSummaryClass()
        => openCriticalIncidents.Count > 0
            ? "alert-critical"
            : openIncidents.Count > 0
                ? "alert-warning"
                : string.Empty;

    private string GetIncidentSummaryText()
        => openCriticalIncidents.Count > 0
            ? LanguageService.Tf("DashboardIncidentSummaryCritical", openCriticalIncidents.Count, openIncidents.Count)
            : openIncidents.Count > 0
                ? LanguageService.Tf("DashboardIncidentSummaryOpen", openIncidents.Count)
                : LanguageService.T("NoOpenIncidents");
}
