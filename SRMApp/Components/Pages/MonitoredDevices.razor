@page "/monitored-devices"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient
@inject ICrudPageDataService CrudPageDataService
@using SRMShared.DTOs.MonitoredDevicePingResult

<PageTitle>@LanguageService.T("MonitoredDevices")</PageTitle>

<PageHeader Title="@LanguageService.T("MonitoredDevices")" Description="@LanguageService.T("MonitoredDevicesOverviewDescription")">
    <Actions>
        <a class="btn btn-primary" href="@GetCreateHref()">@LanguageService.T("CreateMonitoredDevice")</a>
        @if (agentId is not null)
        {
            <a class="btn btn-outline-primary" href="/agents">@LanguageService.T("BackToAgents")</a>
        }
        else if (serverRoomId is not null)
        {
            <a class="btn btn-outline-primary" href="/serverrooms/@serverRoomId/details">@LanguageService.T("BackToServerRooms")</a>
        }
        @if (customerId is not null)
        {
            <a class="btn btn-outline-primary" href="/customers/@customerId/details">@LanguageService.T("BackToCustomerOverview")</a>
        }
    </Actions>
</PageHeader>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else if (items.Count == 0)
{
    <div class="empty-state">
        <h3>@LanguageService.T("NoData")</h3>
        <p class="subtle">@LanguageService.T("MonitoredDevicesOverviewDescription")</p>
        <a class="btn btn-primary" href="@GetCreateHref()">@LanguageService.T("CreateMonitoredDevice")</a>
    </div>
}
else
{
    <div class="stats-grid">
        @foreach (var item in items)
        {
            var cardClass = GetMonitoredDeviceCardClass(item.Id);
            <SummaryStatCard CardClass="@cardClass"
                             IconClass="stat-icon-network-card"
                             Title="@item.DisplayName"
                             Value="@(latestPingByDeviceId.TryGetValue(item.Id, out var ping) ? (ping.IsReachable ? LanguageService.T("Reachable") : LanguageService.T("Unavailable")) : LanguageService.T("Unknown"))"
                             SummaryText="@GetMonitoredSummaryText(item.Id)"
                             SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(cardClass)"
                             SecondaryText="@item.IpAddress">
                <Details>
                    <div>@item.IntervalSeconds s | @item.TimeoutMilliseconds ms</div>
                </Details>
                <Actions>
                    <a class="btn btn-primary btn-sm" href="/monitored-device-ping-results?monitoredDeviceId=@item.Id">@LanguageService.T("MonitoredDevicePingResults")</a>
                    <a class="btn btn-outline-primary btn-sm" href="/incidents?monitoredDeviceId=@item.Id">@LanguageService.T("Incidents")</a>
                    <a class="btn btn-outline-primary btn-sm" href="@GetEditHref(item.Id)">@LanguageService.T("Edit")</a>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(item.Id)">@LanguageService.T("Delete")</button>
                </Actions>
            </SummaryStatCard>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] public Guid? agentId { get; set; }
    [SupplyParameterFromQuery] public Guid? serverRoomId { get; set; }
    [SupplyParameterFromQuery] public Guid? customerId { get; set; }
    private bool isLoading = true;
    private List<MonitoredDeviceReadDto> items = [];
    private Dictionary<Guid, MonitoredDevicePingResultReadDto> latestPingByDeviceId = [];
    private HashSet<Guid> openCriticalIncidentDeviceIds = [];

    protected override async Task OnParametersSetAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        var pageData = await CrudPageDataService.GetMonitoredDevicePageDataAsync(agentId, serverRoomId, customerId);
        items = pageData.Items.ToList();
        latestPingByDeviceId = pageData.LatestPingByDeviceId.ToDictionary();
        openCriticalIncidentDeviceIds = pageData.OpenCriticalIncidentDeviceIds.ToHashSet();
        isLoading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await ApiClient.DeleteMonitoredDeviceAsync(id);
        await LoadAsync();
    }

    private string GetCreateHref()
        => agentId is not null ? $"/monitored-devices/create?agentId={agentId}"
            : serverRoomId is not null ? $"/monitored-devices/create?serverRoomId={serverRoomId}"
            : customerId is not null ? $"/monitored-devices/create?customerId={customerId}"
            : "/monitored-devices/create";

    private string GetEditHref(Guid id)
        => agentId is not null ? $"/monitored-devices/{id}/edit?agentId={agentId}"
            : serverRoomId is not null ? $"/monitored-devices/{id}/edit?serverRoomId={serverRoomId}"
            : customerId is not null ? $"/monitored-devices/{id}/edit?customerId={customerId}"
            : $"/monitored-devices/{id}/edit";

    private string GetMonitoredDeviceCardClass(Guid monitoredDeviceId)
    {
        if (openCriticalIncidentDeviceIds.Contains(monitoredDeviceId)) return "alert-critical";
        if (!latestPingByDeviceId.TryGetValue(monitoredDeviceId, out var latestPing)) return "alert-info";
        if (latestPing.FailureThresholdReached) return "alert-critical";
        if (!latestPing.IsReachable) return "alert-warning";
        return "alert-ok";
    }

    private string GetMonitoredSummaryText(Guid monitoredDeviceId)
    {
        if (!latestPingByDeviceId.TryGetValue(monitoredDeviceId, out var latestPing)) return LanguageService.T("NoPingYet");
        if (latestPing.FailureThresholdReached) return LanguageService.T("MonitoredDeviceThresholdDown");
        if (!latestPing.IsReachable) return LanguageService.T("MonitoredDeviceUnreachable");
        return LanguageService.T("MonitoredDevicesReachable");
    }
}
