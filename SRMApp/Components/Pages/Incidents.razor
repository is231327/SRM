@page "/incidents"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient

<PageTitle>@LanguageService.T("Incidents")</PageTitle>

<div class="page-header">
    <div>
        <h1>@LanguageService.T("Incidents")</h1>
        <p>@LanguageService.T("IncidentsPageDescription")</p>
    </div>
    <div class="page-header-actions">
        @if (serverRoomId is not null)
        {
            <a class="btn btn-outline-primary" href="/serverrooms/@serverRoomId/details">@LanguageService.T("BackToServerRooms")</a>
        }
        else if (customerId is not null)
        {
            <a class="btn btn-outline-primary" href="/customers/@customerId/details">@LanguageService.T("BackToCustomerOverview")</a>
        }
        <button class="btn btn-outline-secondary" @onclick="ToggleClosedIncidentsAsync">
            @LanguageService.T(showClosedIncidents ? "HideClosedIncidents" : "ShowClosedIncidents")
        </button>
    </div>
</div>

<div class="list-controls" aria-label="@LanguageService.T("FilterAndSorting")">
    <div class="list-control list-control-search">
        <label for="incident-search">@LanguageService.T("Search")</label>
        <input id="incident-search" class="form-control" type="search" placeholder="@LanguageService.T("SearchIncidentsPlaceholder")" @bind="incidentSearchText" @bind:event="oninput" />
    </div>
    <div class="list-control">
        <label for="incident-type-filter">@LanguageService.T("IncidentType")</label>
        <select id="incident-type-filter" class="form-select" @bind="incidentTypeFilter">
            <option value="">@LanguageService.T("All")</option>
            @foreach (var type in Enum.GetValues<IncidentType>())
            {
                <option value="@type">@LanguageService.T(type.ToString())</option>
            }
        </select>
    </div>
    <div class="list-control">
        <label for="incident-priority-filter">@LanguageService.T("TicketPriority")</label>
        <select id="incident-priority-filter" class="form-select" @bind="ticketPriorityFilter">
            <option value="">@LanguageService.T("All")</option>
            @foreach (var priority in TicketPriorities)
            {
                <option value="@priority">@LanguageService.T(priority)</option>
            }
        </select>
    </div>
    <div class="list-control">
        <label for="incident-status-filter">@LanguageService.T("TicketStatus")</label>
        <select id="incident-status-filter" class="form-select" @bind="ticketStatusFilter">
            <option value="">@LanguageService.T("All")</option>
            @foreach (var status in TicketStatuses)
            {
                <option value="@status">@LanguageService.T(status)</option>
            }
        </select>
    </div>
    <div class="list-control">
        <label for="incident-sort">@LanguageService.T("SortBy")</label>
        <select id="incident-sort" class="form-select" @bind="incidentSort">
            <option value="DateNewest">@LanguageService.T("DateNewest")</option>
            <option value="DateOldest">@LanguageService.T("DateOldest")</option>
            <option value="PriorityHighest">@LanguageService.T("PriorityHighest")</option>
            <option value="PriorityLowest">@LanguageService.T("PriorityLowest")</option>
            <option value="Status">@LanguageService.T("TicketStatus")</option>
            <option value="ServerRoomAscending">@LanguageService.T("ServerRoomAscending")</option>
            <option value="ServerRoomDescending">@LanguageService.T("ServerRoomDescending")</option>
        </select>
    </div>
    <button class="btn btn-outline-secondary list-control-reset" type="button" @onclick="ResetFilters">@LanguageService.T("ResetFilters")</button>
</div>

@{ var visibleItems = VisibleItems; }
<div class="entity-grid">
    <section class="entity-list">
        @if (isLoading)
        {
            <p>@LanguageService.T("Loading")</p>
        }
        else if (items.Count == 0)
        {
            <p>@LanguageService.T("NoData")</p>
        }
        else if (visibleItems.Count == 0)
        {
            <p>@LanguageService.T("NoMatchingData")</p>
        }
        else
        {
            <p class="list-result-count">@LanguageService.Tf("ShowingResults", visibleItems.Count, items.Count)</p>
            @foreach (var item in visibleItems)
            {
                var ticketLink = item.TicketLinks.FirstOrDefault(x => x.ProviderName == "Redmine")
                    ?? item.TicketLinks.FirstOrDefault();
                var ticketUrl = string.IsNullOrWhiteSpace(ticketLink?.ExternalTicketUrl)
                    ? null
                    : ticketLink.ExternalTicketUrl;
                <article class="entity-card @GetIncidentCardClass(item)">
                    <div class="entity-card-header">
                        <div>
                            <h3>@GetIncidentTitle(item, ticketLink)</h3>
                            <div class="@GetIncidentStatusClass(item)">@LanguageService.T("TicketPriority"): @GetTicketPriority(item, ticketLink) | @LanguageService.T("TicketStatus"): @GetTicketStatus(ticketLink)</div>
                            <div class="subtle">@LanguageService.T("OpenedAt"): <BrowserLocalDateTime Value="@item.OpenedAtUtc" /></div>
                            <div class="subtle">@LanguageService.T("ServerRoom"): @item.ServerRoomName</div>
                            @if (!string.IsNullOrWhiteSpace(item.ShellyDeviceName))
                            {
                                <div class="subtle">@LanguageService.T("ShellyDevice"): @item.ShellyDeviceName</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.MonitoredDeviceName))
                            {
                                <div class="subtle">@LanguageService.T("MonitoredDevice"): @item.MonitoredDeviceName</div>
                            }
                            <div class="subtle">@LanguageService.T("TicketSyncStatus"): @GetTicketSyncStatus(ticketLink)</div>
                        </div>
                    </div>
                    <div class="child-links">
                        <span class="@GetIncidentBadgeClass(item)">@LanguageService.T(item.Type.ToString())</span>
                        @if (ticketUrl is not null)
                        {
                            <a class="btn btn-primary btn-sm" href="@ticketUrl" target="_blank" rel="noopener noreferrer">@LanguageService.T("RedmineTicket")</a>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" disabled>@LanguageService.T("RedmineTicket")</button>
                        }
                    </div>
                </article>
            }
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public Guid? customerId { get; set; }
    [SupplyParameterFromQuery] public Guid? serverRoomId { get; set; }
    [SupplyParameterFromQuery] public Guid? shellyDeviceId { get; set; }
    [SupplyParameterFromQuery] public Guid? monitoredDeviceId { get; set; }

    private bool isLoading = true;
    private bool showClosedIncidents;
    private List<IncidentReadDto> items = [];
    private string incidentSearchText = string.Empty;
    private IncidentType? incidentTypeFilter;
    private string ticketPriorityFilter = string.Empty;
    private string ticketStatusFilter = string.Empty;
    private IncidentSortOption incidentSort = IncidentSortOption.DateNewest;
    private readonly CancellationTokenSource refreshCancellationTokenSource = new();
    private Task? refreshTask;
    private static readonly string[] TicketPriorities = ["Low", "Normal", "High", "Urgent", "Immediate"];
    private static readonly string[] TicketStatuses = ["New", "In Progress", "Resolved", "Feedback", "Closed", "Rejected"];
    private IReadOnlyList<IncidentReadDto> VisibleItems => OperationalListViewHelper.FilterAndSortIncidents(
        items,
        incidentSearchText,
        incidentTypeFilter,
        ticketPriorityFilter,
        ticketStatusFilter,
        incidentSort);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            refreshTask = RefreshPeriodicallyAsync(refreshCancellationTokenSource.Token);
        }

        return Task.CompletedTask;
    }

    private async Task LoadAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            isLoading = true;
        }

        var all = await ApiClient.GetIncidentsAsync(showClosedIncidents);
        var serverRooms = await ApiClient.GetServerRoomsAsync();
        var customerRoomIds = customerId is null
            ? null
            : serverRooms.Where(x => x.CustomerId == customerId.Value).Select(x => x.Id).ToHashSet();
        items = all
            .Where(x => customerRoomIds is null || customerRoomIds.Contains(x.ServerRoomId))
            .Where(x => serverRoomId is null || x.ServerRoomId == serverRoomId)
            .Where(x => shellyDeviceId is null || x.ShellyDeviceId == shellyDeviceId)
            .Where(x => monitoredDeviceId is null || x.MonitoredDeviceId == monitoredDeviceId)
            .ToList();
        isLoading = false;
    }

    private async Task ToggleClosedIncidentsAsync()
    {
        showClosedIncidents = !showClosedIncidents;
        await LoadAsync();
    }

    private void ResetFilters()
    {
        incidentSearchText = string.Empty;
        incidentTypeFilter = null;
        ticketPriorityFilter = string.Empty;
        ticketStatusFilter = string.Empty;
        incidentSort = IncidentSortOption.DateNewest;
    }

    private async Task RefreshPeriodicallyAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync(showLoading: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private static string GetIncidentTitle(IncidentReadDto incident, TicketLinkReadDto? ticketLink)
        => string.IsNullOrWhiteSpace(ticketLink?.ExternalTicketId)
            ? incident.Summary
            : $"{ticketLink.ExternalTicketId} - {incident.Summary}";

    private string GetIncidentCardClass(IncidentReadDto incident)
        => OverviewUiHelper.IsClosedIncident(incident)
            ? "incident-closed"
            : incident.Severity.ToString() switch
        {
            "Critical" => "alert-critical",
            "Major" => "alert-warning",
            _ => string.Empty
        };

    private string GetIncidentBadgeClass(IncidentReadDto incident)
        => incident.Severity.ToString() switch
        {
            "Critical" => "badge-critical",
            "Major" => "badge-warning",
            _ => "badge-soft"
        };

    private string GetIncidentStatusClass(IncidentReadDto incident)
        => OverviewUiHelper.IsClosedIncident(incident)
            ? "subtle"
            : incident.Severity.ToString() switch
        {
            "Critical" => "status-line-critical",
            "Major" => "status-line-warning",
            _ => "subtle"
        };

    private string GetTicketPriority(IncidentReadDto incident, TicketLinkReadDto? ticketLink)
    {
        if (!string.IsNullOrWhiteSpace(ticketLink?.ExternalPriorityName))
        {
            return LanguageService.T(ticketLink.ExternalPriorityName);
        }

        return LanguageService.T(incident.Severity switch
        {
            IncidentSeverity.Warning => "High",
            IncidentSeverity.Major => "Urgent",
            IncidentSeverity.Critical => "Immediate",
            _ => "Unknown"
        });
    }

    private string GetTicketStatus(TicketLinkReadDto? ticketLink)
        => string.IsNullOrWhiteSpace(ticketLink?.ExternalStatusName)
            ? "-"
            : LanguageService.T(ticketLink.ExternalStatusName);

    private string GetTicketSyncStatus(TicketLinkReadDto? ticketLink)
    {
        if (ticketLink is null || ticketLink.SyncStatus == TicketSyncStatus.PendingCreate)
        {
            return LanguageService.T("PendingCreate");
        }

        return string.IsNullOrWhiteSpace(ticketLink.ExternalTicketId)
            ? LanguageService.T("Error")
            : LanguageService.T("Created");
    }

    public override void Dispose()
    {
        refreshCancellationTokenSource.Cancel();
        refreshCancellationTokenSource.Dispose();
        base.Dispose();
    }
}
