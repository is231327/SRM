@page "/agent-credentials"
@inherits LocalizedComponentBase
@inject IAuthApiClient AuthApiClient
@inject ICoreApiClient CoreApiClient
@inject AuthSessionService AuthSessionService
@inject NavigationManager NavigationManager

<PageTitle>@LanguageService.T("AgentCredentials")</PageTitle>

@if (!AuthSessionService.IsAuthenticated)
{
    <div class="alert alert-warning">@LanguageService.T("UsersLoginRequired")</div>
}
else if (!AuthSessionService.CanManageAgentCredentials)
{
    <div class="alert alert-danger">@LanguageService.T("UsersAdminOnly")</div>
}
else
{
    <div class="page-header">
        <div>
            <h1>@LanguageService.T("AgentCredentials")</h1>
            <p>@LanguageService.T("AgentCredentialsPageDescription")</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isErrorMessage ? "alert-danger" : "alert-info")">@statusMessage</div>
    }

    <div class="entity-grid">
        <section class="entity-list">
            @if (isLoading)
            {
                <p>@LanguageService.T("Loading")</p>
            }
            else if (credentials.Count == 0)
            {
                <p>@LanguageService.T("NoData")</p>
            }
            else
            {
                @foreach (var credential in credentials)
                {
                    <article class="entity-card">
                        <div class="entity-card-header">
                            <div>
                                <h3>@credential.ClientIdentifier</h3>
                                <div class="subtle">@FormatAgent(credential.AgentId)</div>
                                <div class="subtle">@LanguageService.T("LastLogin"): @FormatDate(credential.LastAuthenticatedAtUtc)</div>
                            </div>
                            <span class="badge-soft">@(credential.IsActive ? LanguageService.T("Active") : LanguageService.T("Inactive"))</span>
                        </div>
                        <div class="child-links">
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => BeginEdit(credential)">@LanguageService.T("Edit")</button>
                        </div>
                    </article>
                }
            }
        </section>

        <section class="form-card">
            <h3>@(editingId is null ? $"{LanguageService.T("Create")} {LanguageService.T("AgentCredentials")}" : $"{LanguageService.T("Update")} {LanguageService.T("AgentCredentials")}")</h3>
            <EditForm Model="form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form-grid">
                    <div>
                        <label class="form-label">@LanguageService.T("AgentReference")</label>
                        <InputSelect class="form-select" @bind-Value="form.AgentId">
                            <option value="@Guid.Empty">Select agent</option>
                            @foreach (var agent in agents)
                            {
                                <option value="@agent.Id">@agent.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div><label class="form-label">@LanguageService.T("ClientIdentifier")</label><InputText class="form-control" @bind-Value="form.ClientIdentifier" /></div>
                    @if (editingId is null)
                    {
                        <div><label class="form-label">@LanguageService.T("ClientSecret")</label><InputText class="form-control" type="password" @bind-Value="createSecret" /></div>
                    }
                    else
                    {
                        <div>
                            <label class="form-label">@LanguageService.T("ClientSecret")</label>
                            <InputText class="form-control" type="password" @bind-Value="updateSecret" />
                            <div class="subtle">@LanguageService.T("RotateSecretOptional")</div>
                        </div>
                    }
                    <div class="form-check mt-4">
                        <InputCheckbox class="form-check-input" @bind-Value="form.IsActive" />
                        <label class="form-check-label">@LanguageService.T("Active")</label>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@LanguageService.T("Save")</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">@LanguageService.T("Cancel")</button>
                </div>
            </EditForm>
            <p class="subtle">@LanguageService.T("PasswordPolicyHint")</p>
        </section>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isErrorMessage;
    private List<AgentCredentialReadDto> credentials = [];
    private List<AgentReadDto> agents = [];
    private AgentCredentialUpdateRequestDto form = new() { IsActive = true };
    private string createSecret = string.Empty;
    private string updateSecret = string.Empty;
    private Guid? editingId;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthSessionService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        agents = await CoreApiClient.GetAgentsAsync();
        ResetForm();
        await LoadCredentialsAsync();
    }

    private async Task LoadCredentialsAsync()
    {
        isLoading = true;
        try
        {
            credentials = await AuthApiClient.GetAgentCredentialsAsync();
        }
        catch (InvalidOperationException ex)
        {
            isErrorMessage = true;
            statusMessage = ex.Message;
            credentials = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        statusMessage = null;
        isErrorMessage = false;

        try
        {
            if (editingId is null)
            {
                var errors = PasswordPolicy.Validate(createSecret);
                if (errors.Count > 0)
                {
                    isErrorMessage = true;
                    statusMessage = string.Join(" ", errors);
                    return;
                }

                var created = await AuthApiClient.CreateAgentCredentialAsync(new AgentCredentialCreateRequestDto
                {
                    AgentId = form.AgentId,
                    ClientIdentifier = form.ClientIdentifier,
                    ClientSecret = createSecret,
                    IsActive = form.IsActive
                });

                statusMessage = string.Format(LanguageService.T("AgentCredentialCreated"), created?.ClientIdentifier);
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(updateSecret))
                {
                    var errors = PasswordPolicy.Validate(updateSecret);
                    if (errors.Count > 0)
                    {
                        isErrorMessage = true;
                        statusMessage = string.Join(" ", errors);
                        return;
                    }
                }

                var updated = await AuthApiClient.UpdateAgentCredentialAsync(editingId.Value, new AgentCredentialUpdateRequestDto
                {
                    AgentId = form.AgentId,
                    ClientIdentifier = form.ClientIdentifier,
                    NewClientSecret = updateSecret,
                    IsActive = form.IsActive
                });

                statusMessage = string.Format(LanguageService.T("AgentCredentialUpdated"), updated?.ClientIdentifier);
            }

            ResetForm();
            await LoadCredentialsAsync();
        }
        catch (InvalidOperationException ex)
        {
            isErrorMessage = true;
            statusMessage = ex.Message;
        }
    }

    private void BeginEdit(AgentCredentialReadDto credential)
    {
        editingId = credential.Id;
        createSecret = string.Empty;
        updateSecret = string.Empty;
        form = new AgentCredentialUpdateRequestDto
        {
            AgentId = credential.AgentId,
            ClientIdentifier = credential.ClientIdentifier,
            IsActive = credential.IsActive
        };
    }

    private void ResetForm()
    {
        editingId = null;
        createSecret = string.Empty;
        updateSecret = string.Empty;
        form = new AgentCredentialUpdateRequestDto
        {
            AgentId = agents.FirstOrDefault()?.Id ?? Guid.Empty,
            IsActive = true
        };
        isErrorMessage = false;
    }

    private string FormatAgent(Guid agentId)
    {
        return agents.FirstOrDefault(x => x.Id == agentId)?.Name ?? agentId.ToString();
    }

    private string FormatDate(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString("g")
            : LanguageService.T("Never");
    }
}
