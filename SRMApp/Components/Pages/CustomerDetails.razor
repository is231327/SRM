@page "/customers/{CustomerId:guid}/details"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient
@inject IOverviewDataService OverviewDataService
@inject NavigationManager NavigationManager
@using SRMShared.DTOs.MonitoredDevicePingResult

<PageTitle>@LanguageService.T("CustomerOverview")</PageTitle>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else if (customer is null)
{
    <p>@LanguageService.T("NoData")</p>
}
else
{
    <section class="hero hero-customer-overview">
        <div class="hero-copy">
            <span class="eyebrow">@LanguageService.T("CustomerOverview")</span>
            <h1>@customer.Name</h1>
            <p>@BuildCustomerLead()</p>
        </div>
        <div class="hero-actions">
            <a class="btn btn-light" href="/customers">@LanguageService.T("BackToCustomers")</a>
            <a class="btn btn-outline-light" href="/customers/@CustomerId/edit">@LanguageService.T("Edit")</a>
            <button type="button" class="btn btn-outline-light" @onclick="DeleteCustomerAsync">@LanguageService.T("Delete")</button>
        </div>
    </section>

    <div class="stats-grid">
        <SummaryStatCard CardClass="@GetServerRoomsSummaryClass()" IconClass="stat-icon-rooms" Title="@LanguageService.T("ServerRooms")" Value="@serverRooms.Count.ToString()" SummaryText="@GetServerRoomSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetServerRoomsSummaryClass())" ViewAllHref="@($"/customers/{CustomerId}/serverrooms")" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard CardClass="@GetAgentsSummaryClass()" IconClass="stat-icon-agents" Title="@LanguageService.T("Agents")" Value="@agents.Count.ToString()" SummaryText="@GetAgentSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetAgentsSummaryClass())" ViewAllHref="@($"/agents?customerId={CustomerId}")" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard CardClass="@GetShellySummaryClass()" IconClass="stat-icon-sensors" Title="@LanguageService.T("ShellyDevices")" Value="@shellyDevices.Count.ToString()" SummaryText="@GetShellySummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetShellySummaryClass())" ViewAllHref="@($"/shelly-devices?customerId={CustomerId}")" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard CardClass="@GetMonitoredDevicesSummaryClass()" IconClass="stat-icon-network-card" Title="@LanguageService.T("MonitoredDevices")" Value="@monitoredDevices.Count.ToString()" SummaryText="@GetMonitoredSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetMonitoredDevicesSummaryClass())" ViewAllHref="@($"/monitored-devices?customerId={CustomerId}")" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard CardClass="@GetIncidentsSummaryClass()" IconClass="stat-icon-alert" Title="@LanguageService.T("Incidents")" Value="@incidents.Count.ToString()" SummaryText="@GetIncidentSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetIncidentsSummaryClass())" ViewAllHref="@($"/incidents?customerId={CustomerId}")" ViewAllText="@LanguageService.T("ViewAll")" />
        <SummaryStatCard CardClass="@GetMaintenanceSummaryClass()" IconClass="stat-icon-maintenance" Title="@LanguageService.T("MaintenanceWindows")" Value="@maintenanceWindows.Count.ToString()" SummaryText="@GetMaintenanceSummaryText()" SummaryTextClass="@OverviewUiHelper.GetStatusTextClass(GetMaintenanceSummaryClass())" ViewAllHref="@($"/maintenance-windows?customerId={CustomerId}")" ViewAllText="@LanguageService.T("ViewAll")" />
    </div>
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    private bool isLoading = true;
    private CustomerOverviewData? overview;
    private CustomerReadDto? customer => overview?.Customer;
    private IReadOnlyList<ServerRoomReadDto> serverRooms => overview?.ServerRooms ?? [];
    private IReadOnlyList<AgentReadDto> agents => overview?.Agents ?? [];
    private IReadOnlyList<ShellyDeviceReadDto> shellyDevices => overview?.ShellyDevices ?? [];
    private IReadOnlyList<MonitoredDeviceReadDto> monitoredDevices => overview?.MonitoredDevices ?? [];
    private IReadOnlyList<MaintenanceWindowReadDto> maintenanceWindows => overview?.MaintenanceWindows ?? [];
    private IReadOnlyList<IncidentReadDto> incidents => overview?.Incidents ?? [];
    private IReadOnlyList<SensorReadingReadDto> sensorReadings => overview?.SensorReadings ?? [];
    private IReadOnlyList<MonitoredDevicePingResultReadDto> pingResults => overview?.PingResults ?? [];
    private IReadOnlyDictionary<Guid, IReadOnlyList<AgentReadDto>> agentsByRoomId => overview?.AgentsByRoomId ?? new Dictionary<Guid, IReadOnlyList<AgentReadDto>>();
    private IReadOnlyDictionary<Guid, IReadOnlyList<ShellyDeviceReadDto>> shellyDevicesByAgentId => overview?.ShellyDevicesByAgentId ?? new Dictionary<Guid, IReadOnlyList<ShellyDeviceReadDto>>();
    private IReadOnlyDictionary<Guid, IReadOnlyList<MonitoredDeviceReadDto>> monitoredDevicesByAgentId => overview?.MonitoredDevicesByAgentId ?? new Dictionary<Guid, IReadOnlyList<MonitoredDeviceReadDto>>();
    private IReadOnlyDictionary<Guid, SensorReadingReadDto> latestSensorReadingByShellyId => overview?.LatestSensorReadingByShellyId ?? new Dictionary<Guid, SensorReadingReadDto>();
    private IReadOnlyDictionary<Guid, MonitoredDevicePingResultReadDto> latestPingResultByMonitoredDeviceId => overview?.LatestPingResultByMonitoredDeviceId ?? new Dictionary<Guid, MonitoredDevicePingResultReadDto>();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        overview = await OverviewDataService.GetCustomerOverviewAsync(CustomerId);
        isLoading = false;
    }

    private async Task DeleteCustomerAsync()
    {
        if (customer is null)
        {
            return;
        }

        await ApiClient.DeleteCustomerAsync(customer.Id);
        NavigationManager.NavigateTo("/customers");
    }

    private int GetOpenIncidentCount()
        => incidents.Count(OverviewUiHelper.IsOpenIncident);

    private int GetOpenCriticalIncidentCount()
        => incidents.Count(x => OverviewUiHelper.IsOpenIncident(x) && x.Severity.ToString() == "Critical");

    private string GetServerRoomsSummaryClass()
    {
        if (serverRooms.Count == 0)
        {
            return string.Empty;
        }

        if (serverRooms.Any(x => GetServerRoomCardClass(x.Id) == "alert-critical"))
        {
            return "alert-critical";
        }

        if (serverRooms.Any(x => GetServerRoomCardClass(x.Id) == "alert-warning"))
        {
            return "alert-warning";
        }

        return "alert-ok";
    }

    private string GetAgentsSummaryClass()
    {
        if (agents.Count == 0)
        {
            return string.Empty;
        }

        if (agents.Any(x => GetAgentCardClass(x) == "alert-warning"))
        {
            return "alert-warning";
        }

        if (agents.Any(x => GetAgentCardClass(x) == "alert-info"))
        {
            return "alert-info";
        }

        return "alert-ok";
    }

    private string GetShellySummaryClass()
    {
        if (shellyDevices.Count == 0)
        {
            return string.Empty;
        }

        if (shellyDevices.Any(x => GetShellyCardClass(x.Id) == "alert-critical"))
        {
            return "alert-critical";
        }

        if (shellyDevices.Any(x => GetShellyCardClass(x.Id) == "alert-warning"))
        {
            return "alert-warning";
        }

        if (shellyDevices.Any(x => GetShellyCardClass(x.Id) == "alert-info"))
        {
            return "alert-info";
        }

        return "alert-ok";
    }

    private string GetMonitoredDevicesSummaryClass()
    {
        if (monitoredDevices.Count == 0)
        {
            return string.Empty;
        }

        if (monitoredDevices.Any(x => GetMonitoredDeviceCardClass(x.Id) == "alert-critical"))
        {
            return "alert-critical";
        }

        if (monitoredDevices.Any(x => GetMonitoredDeviceCardClass(x.Id) == "alert-warning"))
        {
            return "alert-warning";
        }

        if (monitoredDevices.Any(x => GetMonitoredDeviceCardClass(x.Id) == "alert-info"))
        {
            return "alert-info";
        }

        return "alert-ok";
    }

    private string GetIncidentsSummaryClass()
    {
        if (incidents.Count == 0)
        {
            return string.Empty;
        }

        if (GetOpenCriticalIncidentCount() > 0)
        {
            return "alert-critical";
        }

        if (GetOpenIncidentCount() > 0)
        {
            return "alert-warning";
        }

        return "alert-ok";
    }

    private string GetMaintenanceSummaryClass()
        => maintenanceWindows.Count > 0 ? "alert-ok" : string.Empty;

    private string GetServerRoomCardClass(Guid serverRoomId)
    {
        var roomIncidents = incidents.Where(x => x.ServerRoomId == serverRoomId).ToList();
        if (roomIncidents.Any(x => OverviewUiHelper.IsOpenIncident(x) && x.Severity.ToString() == "Critical"))
        {
            return "alert-critical";
        }

        if (roomIncidents.Any(OverviewUiHelper.IsOpenIncident))
        {
            return "alert-warning";
        }

        return "alert-ok";
    }

    private string GetAgentCardClass(AgentReadDto agent)
        => !agent.IsActive ? "alert-warning" : !agent.LastSeenAtUtc.HasValue ? "alert-info" : "alert-ok";

    private string GetShellyCardClass(Guid shellyDeviceId)
    {
        var criticalIncident = incidents.Any(x => x.ShellyDeviceId == shellyDeviceId && OverviewUiHelper.IsOpenIncident(x) && x.Severity.ToString() == "Critical");
        if (criticalIncident)
        {
            return "alert-critical";
        }

        if (!shellyDevices.First(x => x.Id == shellyDeviceId).IsActive)
        {
            return "alert-warning";
        }

        if (!latestSensorReadingByShellyId.TryGetValue(shellyDeviceId, out var reading))
        {
            return "alert-info";
        }

        if (reading.DoorOpen)
        {
            return "alert-warning";
        }

        return "alert-ok";
    }

    private string GetMonitoredDeviceCardClass(Guid monitoredDeviceId)
    {
        if (!monitoredDevices.First(x => x.Id == monitoredDeviceId).IsActive)
        {
            return "alert-warning";
        }

        if (!latestPingResultByMonitoredDeviceId.TryGetValue(monitoredDeviceId, out var result))
        {
            return "alert-info";
        }

        if (result.FailureThresholdReached)
        {
            return "alert-critical";
        }

        if (!result.IsReachable)
        {
            return "alert-warning";
        }

        return "alert-ok";
    }

    private string BuildCustomerLead()
    {
        var openIncidents = GetOpenIncidentCount();
        var criticalIncidents = GetOpenCriticalIncidentCount();

        if (criticalIncidents > 0)
        {
            return LanguageService.Tf("CustomerLeadCritical", criticalIncidents, serverRooms.Count);
        }

        if (openIncidents > 0)
        {
            return LanguageService.Tf("CustomerLeadOpen", openIncidents);
        }

        return LanguageService.Tf("CustomerLeadStable", serverRooms.Count, agents.Count, shellyDevices.Count);
    }

    private string GetServerRoomSummaryText()
        => serverRooms.Count == 0
            ? LanguageService.T("NoData")
            : serverRooms.Any(x => GetServerRoomCardClass(x.Id) == "alert-critical")
                ? LanguageService.T("ServerRoomCriticalIssue")
                : serverRooms.Any(x => GetServerRoomCardClass(x.Id) == "alert-warning")
                    ? LanguageService.T("ServerRoomOpenIssue")
                    : LanguageService.T("ServerRoomsStable");

    private string GetAgentSummaryText()
        => agents.Count == 0
            ? LanguageService.T("NoData")
            : agents.Any(x => GetAgentCardClass(x) == "alert-warning")
                ? LanguageService.T("InactiveAgentsPresent")
                : agents.Any(x => GetAgentCardClass(x) == "alert-info")
                    ? LanguageService.T("AgentsNotReportedYet")
                    : LanguageService.T("AllAgentsHaveReported");

    private string GetShellySummaryText()
        => shellyDevices.Count == 0
            ? LanguageService.T("NoData")
            : shellyDevices.Any(x => GetShellyCardClass(x.Id) == "alert-critical")
                ? LanguageService.T("ShellyCriticalIncidentOpen")
            : shellyDevices.Any(x => GetShellyCardClass(x.Id) == "alert-warning")
                    ? shellyDevices.Any(x => !x.IsActive)
                        ? LanguageService.T("InactiveShellyDevicesPresent")
                        : LanguageService.T("ShellyDoorOpen")
                    : shellyDevices.Any(x => GetShellyCardClass(x.Id) == "alert-info")
                        ? LanguageService.T("ShellyNoReadingsYet")
                        : LanguageService.T("ShellyReportingNormally");

    private string GetMonitoredSummaryText()
        => monitoredDevices.Count == 0
            ? LanguageService.T("NoData")
            : monitoredDevices.Any(x => GetMonitoredDeviceCardClass(x.Id) == "alert-critical")
                ? LanguageService.T("MonitoredDeviceThresholdDown")
            : monitoredDevices.Any(x => GetMonitoredDeviceCardClass(x.Id) == "alert-warning")
                    ? monitoredDevices.Any(x => !x.IsActive)
                        ? LanguageService.T("InactiveMonitoredDevicesPresent")
                        : LanguageService.T("MonitoredDeviceUnreachable")
                    : monitoredDevices.Any(x => GetMonitoredDeviceCardClass(x.Id) == "alert-info")
                        ? LanguageService.T("MonitoredDeviceNoHistory")
                        : LanguageService.T("MonitoredDevicesReachable");

    private string GetIncidentSummaryText()
        => incidents.Count == 0
            ? LanguageService.T("NoData")
            : GetOpenCriticalIncidentCount() > 0
                ? LanguageService.T("CriticalIncidentsImmediateReview")
                : GetOpenIncidentCount() > 0
                    ? LanguageService.T("OpenIncidentsTracked")
                    : LanguageService.T("NoOpenIncidentsRemain");

    private string GetMaintenanceSummaryText()
        => maintenanceWindows.Count == 0 ? LanguageService.T("NoData") : LanguageService.T("MaintenanceConfigured");
}
