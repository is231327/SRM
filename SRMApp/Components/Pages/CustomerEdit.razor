@page "/customers/{CustomerId:guid}/edit"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICoreApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>@LanguageService.T("EditCustomer")</PageTitle>

<div class="page-header">
    <div>
        <h1>@LanguageService.T("EditCustomer")</h1>
        <p>@LanguageService.T("EditCustomerDescription")</p>
    </div>
    <div class="child-links">
        <a class="btn btn-outline-primary" href="/customers/@CustomerId/details">@LanguageService.T("BackToCustomerOverview")</a>
        <a class="btn btn-outline-secondary" href="/customers">@LanguageService.T("BackToCustomers")</a>
    </div>
</div>

@if (isLoading)
{
    <p>@LanguageService.T("Loading")</p>
}
else if (customer is null)
{
    <p>@LanguageService.T("NoData")</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-info")">@statusMessage</div>
    }

    <section class="form-card">
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <div>
                    <label class="form-label">@LanguageService.T("Name")</label>
                    <InputText class="form-control" @bind-Value="form.Name" />
                    <ValidationMessage For="() => form.Name" />
                </div>
                <div>
                    <label class="form-label">@LanguageService.T("ExternalReference")</label>
                    <InputText class="form-control" @bind-Value="form.ExternalReference" />
                    <ValidationMessage For="() => form.ExternalReference" />
                </div>
                <div>
                    <label class="form-label">@LanguageService.T("Email")</label>
                    <InputText class="form-control" @bind-Value="form.ContactEmail" />
                    <ValidationMessage For="() => form.ContactEmail" />
                </div>
                <div>
                    <label class="form-label">@LanguageService.T("Phone")</label>
                    <InputText class="form-control" @bind-Value="form.ContactPhone" />
                    <ValidationMessage For="() => form.ContactPhone" />
                </div>
                <div class="form-check mt-4"><InputCheckbox class="form-check-input" @bind-Value="form.IsActive" /><label class="form-check-label">@LanguageService.T("Active")</label></div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@LanguageService.T("Save")</button>
                <a class="btn btn-outline-secondary" href="/customers/@CustomerId/details">@LanguageService.T("Cancel")</a>
            </div>
        </EditForm>
    </section>
}

@code {
    [Parameter] public Guid CustomerId { get; set; }

    private bool isLoading = true;
    private bool isError;
    private CustomerReadDto? customer;
    private CustomerUpdateDto form = new();
    private string? statusMessage;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        customer = await ApiClient.GetCustomerAsync(CustomerId)
            ?? (await ApiClient.GetCustomersAsync()).FirstOrDefault(x => x.Id == CustomerId);

        if (customer is not null)
        {
            form = new CustomerUpdateDto
            {
                Name = customer.Name,
                ExternalReference = customer.ExternalReference,
                ContactEmail = customer.ContactEmail,
                ContactPhone = customer.ContactPhone,
                IsActive = customer.IsActive
            };
        }

        isLoading = false;
    }

    private async Task SaveAsync()
    {
        statusMessage = null;
        isError = false;

        var updated = await ApiClient.UpdateCustomerAsync(CustomerId, form);
        if (updated is null)
        {
            isError = true;
            statusMessage = LanguageService.T("CustomerSaveFailed");
            return;
        }

        NavigationManager.NavigateTo($"/customers/{CustomerId}/details");
    }
}
