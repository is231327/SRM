@page "/monitored-device-ping-results"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICrudPageDataService CrudPageDataService
@using SRMShared.DTOs.MonitoredDevicePingResult

<PageTitle>@LanguageService.T("MonitoredDevicePingResults")</PageTitle>

<PageHeader Title="@LanguageService.T("MonitoredDevicePingResults")">
    <Actions>
        @if (monitoredDeviceId is not null)
        {
            <a class="btn btn-outline-primary" href="/monitored-devices">@LanguageService.T("MonitoredDevices")</a>
        }
    </Actions>
</PageHeader>

<div class="list-controls" aria-label="@LanguageService.T("FilterAndSorting")">
    <div class="list-control">
        <label for="ping-reachability-filter">@LanguageService.T("Reachability")</label>
        <select id="ping-reachability-filter" class="form-select" @bind="reachabilityFilter">
            <option value="All">@LanguageService.T("All")</option>
            <option value="Yes">@LanguageService.T("Reachable")</option>
            <option value="No">@LanguageService.T("PingUnavailable")</option>
        </select>
    </div>
    <div class="list-control">
        <label for="ping-threshold-filter">@LanguageService.T("ThresholdReached")</label>
        <select id="ping-threshold-filter" class="form-select" @bind="thresholdFilter">
            <option value="All">@LanguageService.T("All")</option>
            <option value="Yes">@LanguageService.T("Yes")</option>
            <option value="No">@LanguageService.T("No")</option>
        </select>
    </div>
    <div class="list-control">
        <label for="ping-sort">@LanguageService.T("SortBy")</label>
        <select id="ping-sort" class="form-select" @bind="sortOption">
            <option value="RecordedNewest">@LanguageService.T("DateNewest")</option>
            <option value="RecordedOldest">@LanguageService.T("DateOldest")</option>
            <option value="RoundtripFastest">@LanguageService.T("RoundtripFastest")</option>
            <option value="RoundtripSlowest">@LanguageService.T("RoundtripSlowest")</option>
            <option value="FailureCountHighest">@LanguageService.T("FailureCountHighest")</option>
            <option value="FailureCountLowest">@LanguageService.T("FailureCountLowest")</option>
        </select>
    </div>
    <button class="btn btn-outline-secondary list-control-reset" type="button" @onclick="ResetFilters">@LanguageService.T("ResetFilters")</button>
</div>

@{ var visibleItems = VisibleItems; }
<section class="entity-list">
    @if (isLoading)
    {
        <p>@LanguageService.T("Loading")</p>
    }
    else if (items.Count == 0)
    {
        <p>@LanguageService.T("NoData")</p>
    }
    else if (visibleItems.Count == 0)
    {
        <p>@LanguageService.T("NoMatchingData")</p>
    }
    else
    {
        <p class="list-result-count">@LanguageService.Tf("ShowingResults", visibleItems.Count, items.Count)</p>
        @foreach (var item in visibleItems)
        {
            <article class="entity-card">
                <div class="entity-card-header">
                    <div>
                        <h3>@(item.IsReachable ? LanguageService.T("Reachable") : LanguageService.T("PingUnavailable"))</h3>
                        <div class="subtle">@LanguageService.T("RecordedAt"): <BrowserLocalDateTime Value="@item.RecordedAtUtc" /></div>
                        <div class="subtle">@LanguageService.T("Roundtrip"): @item.RoundtripTimeMilliseconds ms</div>
                        <div class="subtle">@LanguageService.T("FailureCount"): @item.ConsecutiveFailureCount | @LanguageService.T("ThresholdReached"): @(item.FailureThresholdReached ? LanguageService.T("Yes") : LanguageService.T("No"))</div>
                        @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                        {
                            <div class="subtle">@LanguageService.T("ErrorMessage"): @item.ErrorMessage</div>
                        }
                    </div>
                </div>
            </article>
        }
    }
</section>

@code {
    [SupplyParameterFromQuery] public Guid? monitoredDeviceId { get; set; }

    private bool isLoading = true;
    private List<MonitoredDevicePingResultReadDto> items = [];
    private TernaryFilter reachabilityFilter = TernaryFilter.All;
    private TernaryFilter thresholdFilter = TernaryFilter.All;
    private PingResultSortOption sortOption = PingResultSortOption.RecordedNewest;
    private IReadOnlyList<MonitoredDevicePingResultReadDto> VisibleItems
        => OperationalListViewHelper.FilterAndSortPingResults(items, reachabilityFilter, thresholdFilter, sortOption);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        items = (await CrudPageDataService.GetMonitoredDevicePingResultPageDataAsync(monitoredDeviceId)).Items.ToList();
        isLoading = false;
    }

    private void ResetFilters()
    {
        reachabilityFilter = TernaryFilter.All;
        thresholdFilter = TernaryFilter.All;
        sortOption = PingResultSortOption.RecordedNewest;
    }
}
