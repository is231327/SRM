@page "/monitored-device-ping-results"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject ICrudPageDataService CrudPageDataService
@using SRMShared.DTOs.MonitoredDevicePingResult

<PageTitle>@LanguageService.T("MonitoredDevicePingResults")</PageTitle>

<PageHeader Title="@LanguageService.T("MonitoredDevicePingResults")" Description="@LanguageService.T("AgentChildren")">
    <Actions>
        @if (monitoredDeviceId is not null)
        {
            <a class="btn btn-outline-primary" href="/monitored-devices">@LanguageService.T("MonitoredDevices")</a>
        }
    </Actions>
</PageHeader>

<section class="entity-list">
    @if (isLoading)
    {
        <p>@LanguageService.T("Loading")</p>
    }
    else if (items.Count == 0)
    {
        <p>@LanguageService.T("NoData")</p>
    }
    else
    {
        @foreach (var item in items.OrderByDescending(x => x.RecordedAtUtc))
        {
            <article class="entity-card">
                <div class="entity-card-header">
                    <div>
                        <h3>@(item.IsReachable ? LanguageService.T("Reachable") : LanguageService.T("PingUnavailable"))</h3>
                        <div class="subtle">@LanguageService.T("RecordedAt"): <BrowserLocalDateTime Value="@item.RecordedAtUtc" /></div>
                        <div class="subtle">@LanguageService.T("Roundtrip"): @item.RoundtripTimeMilliseconds ms</div>
                        <div class="subtle">@LanguageService.T("FailureCount"): @item.ConsecutiveFailureCount | @LanguageService.T("ThresholdReached"): @(item.FailureThresholdReached ? LanguageService.T("Yes") : LanguageService.T("No"))</div>
                        @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                        {
                            <div class="subtle">@LanguageService.T("ErrorMessage"): @item.ErrorMessage</div>
                        }
                    </div>
                </div>
            </article>
        }
    }
</section>

@code {
    [SupplyParameterFromQuery] public Guid? monitoredDeviceId { get; set; }

    private bool isLoading = true;
    private List<MonitoredDevicePingResultReadDto> items = [];

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        items = (await CrudPageDataService.GetMonitoredDevicePingResultPageDataAsync(monitoredDeviceId)).Items.ToList();
        isLoading = false;
    }
}
