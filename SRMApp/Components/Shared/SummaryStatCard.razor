<div class="stat-card @CardClass">
    <h3 class="stat-title">
        @if (!string.IsNullOrWhiteSpace(IconClass))
        {
            <span class="stat-icon @IconClass"></span>
        }
        @Title
    </h3>
    <div class="stat-value">@Value</div>

    @if (!string.IsNullOrWhiteSpace(SummaryText))
    {
        <div class="@SummaryTextClass">@SummaryText</div>
    }

    @if (!string.IsNullOrWhiteSpace(SecondaryText))
    {
        <div class="subtle">@SecondaryText</div>
    }

    @if (Details is not null)
    {
        <div class="subtle">
            @Details
        </div>
    }

    @if (Actions is not null)
    {
        <div class="child-links">
            @Actions
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ViewAllHref))
    {
        <div class="child-links">
            <a class="btn btn-outline-primary btn-sm" href="@ViewAllHref">@ViewAllText</a>
        </div>
    }
</div>

@code {
    [Parameter] public string CardClass { get; set; } = string.Empty;
    [Parameter] public string IconClass { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string SummaryText { get; set; } = string.Empty;
    [Parameter] public string SummaryTextClass { get; set; } = "subtle";
    [Parameter] public string SecondaryText { get; set; } = string.Empty;
    [Parameter] public string ViewAllHref { get; set; } = string.Empty;
    [Parameter] public string ViewAllText { get; set; } = "View All";
    [Parameter] public RenderFragment? Details { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
