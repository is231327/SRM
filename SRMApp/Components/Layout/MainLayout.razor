@inherits LayoutComponentBase
@implements IDisposable
@inject LanguageService LanguageService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 app-topbar">
            <div class="topbar-title">SRM</div>
            <div class="language-switch">
                <label>@LanguageService.T("Language")</label>
                <button class="lang-btn @(LanguageService.CurrentLanguage == "en" ? "active" : string.Empty)" @onclick='() => LanguageService.SetLanguage("en")'>
                    @LanguageService.T("English")
                </button>
                <button class="lang-btn @(LanguageService.CurrentLanguage == "de" ? "active" : string.Empty)" @onclick='() => LanguageService.SetLanguage("de")'>
                    @LanguageService.T("German")
                </button>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized()
    {
        LanguageService.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LanguageService.LanguageChanged -= OnLanguageChanged;
    }
}
