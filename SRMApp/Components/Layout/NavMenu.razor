@inherits LocalizedComponentBase
@inject AuthSessionService AuthSessionService
@inject IAuthApiClient AuthApiClient
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid brand-box">
        <a class="navbar-brand" href="">SRM</a>
        <span class="brand-subtitle">@LanguageService.T("AppTitle")</span>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @if (!AuthSessionService.IsAuthenticated)
        {
            <div class="nav-item px-3"><NavLink class="nav-link" href="login"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("Login")</NavLink></div>
        }
        else
        {
            <div class="nav-item px-3"><button type="button" class="nav-link btn btn-link text-start w-100" @onclick="LogoutAsync">@LanguageService.T("Logout") (@AuthSessionService.CurrentUser?.Username)</button></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="profile"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("Profile")</NavLink></div>
        }
        @if (!AuthSessionService.IsAuthenticated)
        {
            <div class="nav-item px-3"><NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span class="bi bi-house-door-fill-nav-menu"></span>@LanguageService.T("Home")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="help"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("Help")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="contact"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("Contact")</NavLink></div>
        }
        else if (!AuthSessionService.MustChangePassword)
        {
            <div class="nav-item px-3"><NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span class="bi bi-house-door-fill-nav-menu"></span>@LanguageService.T("Home")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="dashboard"><span class="bi bi-plus-square-fill-nav-menu"></span>@LanguageService.T("Dashboard")</NavLink></div>
            @if (AuthSessionService.CanManageUsers)
            {
                <div class="nav-item px-3"><NavLink class="nav-link" href="users"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("Users")</NavLink></div>
                <div class="nav-item px-3"><NavLink class="nav-link" href="agent-credentials"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("AgentCredentials")</NavLink></div>
            }
            @if (AuthSessionService.CanManageCustomers)
            {
                <div class="nav-item px-3"><NavLink class="nav-link" href="customers"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("Customers")</NavLink></div>
            }
            <div class="nav-item px-3"><NavLink class="nav-link" href="serverrooms"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("ServerRooms")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="agents"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("Agents")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="shelly-devices"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("ShellyDevices")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="monitored-devices"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("MonitoredDevices")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="monitored-device-ping-results"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("MonitoredDevicePingResults")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="maintenance-windows"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("MaintenanceWindows")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="sensor-readings"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("SensorReadings")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="help"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("Help")</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="contact"><span class="bi bi-list-nested-nav-menu"></span>@LanguageService.T("Contact")</NavLink></div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        AuthSessionService.AuthenticationChanged += OnAuthenticationChanged;
    }

    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }

    private void OnAuthenticationChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        AuthSessionService.AuthenticationChanged -= OnAuthenticationChanged;
        base.Dispose();
    }
}
