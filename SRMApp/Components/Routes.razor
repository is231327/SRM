@inject AuthSessionService AuthSessionService
@inject IAuthApiClient AuthApiClient
@inject NavigationManager NavigationManager
@inject ILogger<Routes> Logger
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (!isReady)
{
    <LayoutView Layout="typeof(Layout.MainLayout)">
        <p>Loading...</p>
    </LayoutView>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            @if (HandleRouteGuard(routeData.PageType))
            {
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            }
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <p>Page not found.</p>
            </LayoutView>
        </NotFound>
    </Router>
}
@code {
    private static readonly HashSet<string> PublicPageNames =
    [
        "Home",
        "Login",
        "Help",
        "Contact",
        "Error"
    ];

    private bool isReady;
    private DotNetObjectReference<Routes>? syncReference;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AuthSessionService.InitializeAsync();

            if (AuthSessionService.IsAuthenticated && !string.IsNullOrWhiteSpace(AuthSessionService.AccessToken))
            {
                var ensured = await AuthApiClient.EnsureAccessTokenAsync();
                var profile = ensured ? await AuthApiClient.GetOwnProfileAsync() : null;
                if (profile is null)
                {
                    await AuthSessionService.ClearAsync();
                }
                else
                {
                    await AuthSessionService.UpdateCurrentUserAsync(profile);
                }
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to restore the authenticated UI session during route initialization.");
            await AuthSessionService.ClearAsync();
        }

        AuthSessionService.AuthenticationChanged += OnAuthenticationChanged;
        isReady = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        syncReference = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("srmAuthSessionSync.subscribe", syncReference);
    }

    [JSInvokable]
    public async Task OnAuthSessionStorageChanged()
    {
        await AuthSessionService.SynchronizeFromStoreAsync();
    }

    private bool HandleRouteGuard(Type pageType)
    {
        var pageName = pageType.Name;
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];

        if (!AuthSessionService.IsAuthenticated)
        {
            if (PublicPageNames.Contains(pageName))
            {
                return true;
            }

            NavigateTo("/login", relativePath);
            return false;
        }

        if (AuthSessionService.MustChangePassword && pageName is not "Profile" and not "Login" and not "Error")
        {
            NavigateTo("/profile", relativePath);
            return false;
        }

        if (pageName == "Login")
        {
            NavigateTo(AuthSessionService.MustChangePassword ? "/profile" : "/", relativePath);
            return false;
        }

        if (!UiPageAccessPolicy.CanAccess(pageName, AuthSessionService))
        {
            NavigateTo("/dashboard", relativePath);
            return false;
        }

        return true;
    }

    private void NavigateTo(string target, string currentRelativePath)
    {
        var targetRelativePath = target.TrimStart('/');
        if (string.Equals(currentRelativePath, targetRelativePath, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(() => NavigationManager.NavigateTo(target));
    }

    private void OnAuthenticationChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        AuthSessionService.AuthenticationChanged -= OnAuthenticationChanged;
        try
        {
            await JSRuntime.InvokeVoidAsync("srmAuthSessionSync.unsubscribe");
        }
        catch (JSDisconnectedException)
        {
        }
        syncReference?.Dispose();
    }
}
