# Copy to .env.local. Every value is treated as sensitive and the file is ignored.
SQL_ACCEPT_EULA=Y
SQL_EDITION=Developer
SQL_HOST=replace-with-local-sql-host
SQL_PORT=1433
SQL_HOST_PORT=1433
SQL_USERNAME=replace-with-local-sql-username
SQL_PASSWORD=replace-with-a-strong-local-sql-password
SQL_AUTH_DATABASE=replace-with-local-auth-database
SQL_CORE_DATABASE=replace-with-local-core-database
REDIS_HOST=replace-with-local-redis-host
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDMINE_DB_HOST=replace-with-local-redmine-database-host
REDMINE_DB_NAME=replace-with-local-redmine-database
REDMINE_DB_USERNAME=replace-with-local-redmine-username
REDMINE_DB_PASSWORD=replace-with-a-strong-local-postgres-password
REDMINE_HOST=replace-with-local-redmine-host
REDMINE_PORT=3000
REDMINE_HOST_PORT=3000
DOTNET_ENVIRONMENT=Production
DOTNET_HTTP_PORTS=8080
AUTH_HOST_PORT=7031
CORE_HOST_PORT=7030
APP_HOST_PORT=7001
AGENT_HOST_PORT=7032
SHELLY_PORT=5000
SHELLY1_HOST_PORT=5000
SHELLY2_HOST_PORT=5001
SHELLY3_HOST_PORT=5002
JWT_ISSUER=replace-with-local-jwt-issuer
JWT_AUDIENCE=replace-with-local-jwt-audience
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
BOOTSTRAP_ADMIN_USERNAME=replace-with-local-admin-username
BOOTSTRAP_ADMIN_EMAIL=replace-with-local-admin-email
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
BOOTSTRAP_ADMIN_FIRST_NAME=replace-with-local-admin-first-name
BOOTSTRAP_ADMIN_LAST_NAME=replace-with-local-admin-last-name
BOOTSTRAP_ADMIN_PHONE_NUMBER=
BOOTSTRAP_ADMIN_MUST_CHANGE_PASSWORD=true
REDMINE_ENABLED=false
REDMINE_API_KEY=
REDMINE_ADMIN_USERNAME=replace-with-local-redmine-admin-username
REDMINE_ADMIN_PASSWORD=replace-with-a-strong-local-redmine-admin-password
REDMINE_PROJECT_IDENTIFIER=replace-with-local-redmine-project
REDMINE_TRACKER_ID=1
REDMINE_STATUS_ID=1
REDMINE_POLL_INTERVAL_SECONDS=15
REDMINE_WARNING_PRIORITY_ID=3
REDMINE_MAJOR_PRIORITY_ID=4
REDMINE_CRITICAL_PRIORITY_ID=5
CORE_HOST=replace-with-local-core-host
AUTH_HOST=replace-with-local-auth-host
AGENT_CLIENT_IDENTIFIER=replace-with-local-agent-identifier
AGENT_CLIENT_SECRET=replace-with-a-strong-local-agent-secret
