# Copy to .env.azure. Every value is treated as sensitive and the file is ignored.
# Container App host names must be unique within the Container Apps environment.
SQL_ACCEPT_EULA=Y
SQL_EDITION=Developer
SQL_HOST=replace-with-azure-sql-app-name
SQL_PORT=1433
SQL_USERNAME=replace-with-azure-sql-username
SQL_PASSWORD=replace-with-a-strong-azure-sql-password
SQL_AUTH_DATABASE=replace-with-azure-auth-database
SQL_CORE_DATABASE=replace-with-azure-core-database
REDIS_HOST=replace-with-azure-redis-app-name
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-azure-redis-password
REDMINE_DB_HOST=replace-with-azure-redmine-database-app-name
REDMINE_DB_PORT=5432
REDMINE_DB_NAME=replace-with-azure-redmine-database
REDMINE_DB_USERNAME=replace-with-azure-redmine-username
REDMINE_DB_PASSWORD=replace-with-a-strong-azure-postgres-password
REDMINE_HOST=replace-with-azure-redmine-app-name
REDMINE_PORT=3000
AUTH_HOST=replace-with-azure-auth-app-name
CORE_HOST=replace-with-azure-core-app-name
APP_HOST=replace-with-azure-ui-app-name
AGENT_HOST=replace-with-azure-agent-app-name
SHELLY_HOST=replace-with-azure-shelly-app-name
SHELLY_PORT=5000
DOTNET_ENVIRONMENT=Production
DOTNET_HTTP_PORTS=8080
JWT_ISSUER=replace-with-azure-jwt-issuer
JWT_AUDIENCE=replace-with-azure-jwt-audience
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
BOOTSTRAP_ADMIN_USERNAME=replace-with-azure-admin-username
BOOTSTRAP_ADMIN_EMAIL=replace-with-azure-admin-email
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-azure-admin-password
BOOTSTRAP_ADMIN_FIRST_NAME=replace-with-azure-admin-first-name
BOOTSTRAP_ADMIN_LAST_NAME=replace-with-azure-admin-last-name
BOOTSTRAP_ADMIN_PHONE_NUMBER=
BOOTSTRAP_ADMIN_MUST_CHANGE_PASSWORD=true
REDMINE_ENABLED=false
REDMINE_API_KEY=replace-with-azure-redmine-api-key-or-a-random-disabled-value
REDMINE_ADMIN_USERNAME=replace-with-azure-redmine-admin-username
REDMINE_ADMIN_PASSWORD=replace-with-a-strong-azure-redmine-admin-password
REDMINE_PROJECT_IDENTIFIER=replace-with-azure-redmine-project
REDMINE_TRACKER_ID=1
REDMINE_STATUS_ID=1
REDMINE_POLL_INTERVAL_SECONDS=15
REDMINE_WARNING_PRIORITY_ID=3
REDMINE_MAJOR_PRIORITY_ID=4
REDMINE_CRITICAL_PRIORITY_ID=5
AGENT_CLIENT_IDENTIFIER=replace-with-azure-agent-identifier
AGENT_CLIENT_SECRET=replace-with-a-strong-azure-agent-secret
