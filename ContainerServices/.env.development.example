# Copy to .env.development. Every value is treated as sensitive and the file is ignored.
SQL_ACCEPT_EULA=Y
SQL_EDITION=Developer
SQL_HOST=localhost
SQL_PORT=1433
SQL_HOST_PORT=1433
SQL_USERNAME=replace-with-development-sql-username
SQL_PASSWORD=replace-with-a-strong-development-sql-password
SQL_AUTH_DATABASE=replace-with-development-auth-database
SQL_CORE_DATABASE=replace-with-development-core-database
SQL_TEST_AUTH_DATABASE=replace-with-development-test-auth-database
SQL_TEST_CORE_DATABASE=replace-with-development-test-core-database
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-development-redis-password
REDIS_HOST_PORT=6379
REDMINE_DB_HOST=replace-with-development-redmine-database-host
REDMINE_DB_NAME=replace-with-development-redmine-database
REDMINE_DB_USERNAME=replace-with-development-redmine-username
REDMINE_DB_PASSWORD=replace-with-a-strong-development-postgres-password
REDMINE_HOST=localhost
REDMINE_PORT=3000
REDMINE_HOST_PORT=3000
SHELLY_PORT=5000
SHELLY1_HOST_PORT=5000
SHELLY2_HOST_PORT=5001
SHELLY3_HOST_PORT=5002
JWT_ISSUER=replace-with-development-jwt-issuer
JWT_AUDIENCE=replace-with-development-jwt-audience
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
BOOTSTRAP_ADMIN_USERNAME=replace-with-development-admin-username
BOOTSTRAP_ADMIN_EMAIL=replace-with-development-admin-email
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-development-admin-password
BOOTSTRAP_ADMIN_FIRST_NAME=replace-with-development-admin-first-name
BOOTSTRAP_ADMIN_LAST_NAME=replace-with-development-admin-last-name
BOOTSTRAP_ADMIN_PHONE_NUMBER=
BOOTSTRAP_ADMIN_MUST_CHANGE_PASSWORD=true
REDMINE_ENABLED=false
REDMINE_API_KEY=
REDMINE_ADMIN_USERNAME=replace-with-development-redmine-admin-username
REDMINE_ADMIN_PASSWORD=replace-with-a-strong-development-redmine-admin-password
REDMINE_PROJECT_IDENTIFIER=replace-with-development-redmine-project
REDMINE_TRACKER_ID=1
REDMINE_STATUS_ID=1
REDMINE_POLL_INTERVAL_SECONDS=15
REDMINE_WARNING_PRIORITY_ID=3
REDMINE_MAJOR_PRIORITY_ID=4
REDMINE_CRITICAL_PRIORITY_ID=5
CORE_HOST=localhost
CORE_PORT=5140
AUTH_HOST=localhost
AUTH_PORT=5141
AGENT_CLIENT_IDENTIFIER=replace-with-development-agent-identifier
AGENT_CLIENT_SECRET=replace-with-a-strong-development-agent-secret
